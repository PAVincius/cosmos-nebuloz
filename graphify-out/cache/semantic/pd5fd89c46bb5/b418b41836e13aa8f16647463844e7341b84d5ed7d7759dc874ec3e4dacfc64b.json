    },
    {
      "id": "docs_produto_meridian_prd_bateria_respondente",
      "label": "Bateria do respondente (/meridian-responder/<token>)",
      "file_type": "concept",
      "source_file": "docs/produto/meridian-prd.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Respondente sem conta responde por link individual com validade, um eixo por vez, rascunho retom\u00e1vel e evid\u00eancia at\u00e9 10 MB."
    },
    {
      "id": "docs_produto_meridian_prd_consultant_role",
      "label": "Consultora Nebuloz (CONSULTANT)",
      "file_type": "concept",
      "source_file": "docs/produto/meridian-prd.md",
