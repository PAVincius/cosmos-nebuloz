    {
      "id": "_github_workflows_ci_risk_score_job",
      "label": "AI Risk Score (CI job)",
      "file_type": "code",
      "source_file": ".github/workflows/ci.yml",
      "source_location": "jobs.risk-score",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "S\u00f3 roda em pull_request; contents: read \u00e9 obrigat\u00f3rio porque declarar permissions no job zera as outras \u2014 sem isso o checkout falhava com 404 em vez de 403 em repo privado, e o job falhava em 100% dos PRs. ANTHROPIC_API_KEY ausente vira aviso vis\u00edvel no summary, n\u00e3o vermelho silencioso."
