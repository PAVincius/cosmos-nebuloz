    {
      "id": "apps_app_components_meridian_design_no_css_token_file",
      "label": "No shared token file across the four product .css copies",
      "file_type": "rationale",
      "rationale": "charter.css/meridian.css/scaffold.css/signal.css are separate rescoped copies with no common file; changing one token means changing all four, and copies already diverge.",
      "source_file": "apps/app/components/meridian/DESIGN.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null
    },
    {
      "id": "apps_app_components_meridian_design_fs_scale_not_declared_debt",
      "label": "--fs-* six-step scale undeclared in the four product roots",
      "file_type": "rationale",
      "rationale": "The six steps live only in .cosmos-root; under Charter/Meridian/Scaffold/Signal roots FS.* does not resolve and text falls back to the 16px body size.",
      "source_file": "apps/app/components/meridian/DESIGN.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null
    },
    {
      "id": "apps_app_components_meridian_design_grain_selector_mismatch",
      "label": "Grain texture selector never matches (deliberate false positive)",
      "file_type": "rationale",
      "rationale": "The .grain selector needs a descendant of the product root, but the shell puts both classes on the same element, so grain never renders; Impeccable flags it as a known false positive.",
      "source_file": "apps/app/components/meridian/DESIGN.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null
    },
    {
      "id": "apps_app_components_meridian_design_neutral_token_missing",
      "label": "--neutral/--neutral-rgb missing in meridian.css",
      "file_type": "rationale",
      "rationale": "Radar's dashed median and BenchBand's p25-p75 band consume --neutral, but meridian.css never declares it, so the two elements do not paint.",
      "source_file": "apps/app/components/meridian/DESIGN.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null
    },
