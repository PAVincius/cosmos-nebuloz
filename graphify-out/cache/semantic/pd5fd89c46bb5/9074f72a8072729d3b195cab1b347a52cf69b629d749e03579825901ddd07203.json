    {
      "id": "apps_app_components_meridian_design_gray_button_no_hover_decision",
      "label": "Buttons have no :hover state (system decision)",
      "file_type": "rationale",
      "rationale": "No product's .btn defines :hover; the only feedback is :active \u2014 a deliberate decision from Charter wave 6, not an oversight.",
      "source_file": "apps/app/components/meridian/DESIGN.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null
    },
    {
      "id": "apps_app_components_meridian_design_adr_0010_self_sufficient_roots",
      "label": "ADR-0010: each product root is self-sufficient",
      "file_type": "rationale",
      "rationale": "Meridian must not bring in Cosmos's lavender accent (#5e6ad2) or import cosmos.css \u2014 each of the four raizes stays self-contained.",
      "source_file": "apps/app/components/meridian/DESIGN.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null
    },
    {
      "id": "apps_app_components_meridian_design_adr_0004_no_persona_switch",
      "label": "ADR-0004: no persona switcher in topbar",
      "file_type": "rationale",
      "rationale": "Role comes from the session; porting the prototype's persona switcher into the topbar would be a privilege-escalation vector.",
      "source_file": "apps/app/components/meridian/DESIGN.md",
