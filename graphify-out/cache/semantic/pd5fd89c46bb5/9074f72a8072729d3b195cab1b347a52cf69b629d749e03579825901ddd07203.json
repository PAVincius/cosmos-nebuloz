    {
      "id": "apps_app_components_meridian_design_observatorio_noturno",
      "label": "O Observat\u00f3rio Noturno (Meridian creative north star)",
      "file_type": "rationale",
      "rationale": "Near-black canvas, instruments that only light up when observed, every reading catalogued with its origin and confidence.",
      "source_file": "apps/app/components/meridian/DESIGN.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null
    },
    {
      "id": "apps_app_components_meridian_design_colored_fact_rule",
      "label": "The Colored Fact Rule",
      "file_type": "rationale",
      "rationale": "Red/amber/green reserved for negative-critical, attention-or-money, and positive fact; category/role/decoration use accent, blue or purple.",
      "source_file": "apps/app/components/meridian/DESIGN.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null
    },
    {
      "id": "apps_app_components_meridian_design_color_plus_word_rule",
      "label": "The Color-Plus-Word Rule",
      "file_type": "rationale",
      "rationale": "State never rides on colour alone: StatusDot carries a label, heatmap cell carries the number, charts carry a legend \u2014 an accessibility requirement (NFR-2).",
      "source_file": "apps/app/components/meridian/DESIGN.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null
    },
    {
      "id": "apps_app_components_meridian_design_four_slot_rule",
      "label": "The Four-Slot Rule",
      "file_type": "rationale",
      "rationale": "Every tone exists as --x, --x-rgb, --x-soft, --x-text; text uses -text, background -soft, border rgba(x,.2-.35), solid fill reserved for point/bar/stroke.",
      "source_file": "apps/app/components/meridian/DESIGN.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null
    },
    {
      "id": "apps_app_components_meridian_design_polarity_rule",
      "label": "The Polarity Rule",
      "file_type": "rationale",
      "rationale": "Glyph over a solid fill uses the theme's --accent-fg (white in light, canvas in dark); white on sky drops to 2.2:1, a white check vanishes on butter.",
      "source_file": "apps/app/components/meridian/DESIGN.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null
    },
    {
      "id": "apps_app_components_meridian_design_mono_for_measure_rule",
      "label": "The Mono-for-Measure Rule",
      "file_type": "rationale",
      "rationale": "Every identifier and measure (case code, count, date, version, percentage) renders in JetBrains Mono; prose never renders in mono.",
      "source_file": "apps/app/components/meridian/DESIGN.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null
    },
    {
      "id": "apps_app_components_meridian_design_six_step_rule",
      "label": "The Six-Step Rule",
      "file_type": "rationale",
      "rationale": "Text size only from the six suite steps (micro 10px..display 22px); a new size is a new step, migrate a literal to the nearest step, tie rounds down.",
      "source_file": "apps/app/components/meridian/DESIGN.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null
    },
    {
      "id": "apps_app_components_meridian_design_single_uppercase_rule",
      "label": "The Single-Uppercase Rule",
      "file_type": "rationale",
      "rationale": "Uppercase only in Eyebrow and mono stamps, always with open letter-spacing; any other UI uppercase is a sizing error.",
      "source_file": "apps/app/components/meridian/DESIGN.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null
    },
    {
      "id": "apps_app_components_meridian_design_one_cols_rule",
      "label": "The One-Cols Rule",
      "file_type": "rationale",
      "rationale": "Table header and row must share a single 'cols' template, or the header column drifts from the row column on the first resize.",
      "source_file": "apps/app/components/meridian/DESIGN.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null
    },
    {
      "id": "apps_app_components_meridian_design_responding_glow_rule",
      "label": "The Responding-Glow Rule",
      "file_type": "rationale",
      "rationale": "At rest a card only has --card-shadow; lift, hover-shadow and tone glow are hover responses, and the KPI decorative layers wake only in dark theme.",
      "source_file": "apps/app/components/meridian/DESIGN.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null
    },
    {
      "id": "apps_app_components_meridian_design_night_texture_rule",
      "label": "The Night-Texture Rule",
      "file_type": "rationale",
      "rationale": "Fractal grain and 64px grid exist only in dark theme; in light theme they 'become dirt, not texture' (scaffold.css:131).",
      "source_file": "apps/app/components/meridian/DESIGN.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null
    },
    {
      "id": "apps_app_components_meridian_design_dashed_seal_rule",
      "label": "The Dashed-Seal Rule",
      "file_type": "rationale",
      "rationale": "Data from another product gets a dashed border plus lock, marked read-only: 'the dashed border says not yours, the lock says not editable here.'",
      "source_file": "apps/app/components/meridian/DESIGN.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null
    },
