    {
      "id": "docs_compliance_dpa_modelo_secao4_confidencialidade",
      "label": "\u00a74 Confidencialidade e pessoas autorizadas",
      "file_type": "concept",
      "source_file": "docs/compliance/dpa-modelo.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "A trilha de auditoria registra a\u00e7\u00f5es, n\u00e3o leitura de dado por staff \u2014 prometer 'todo acesso \u00e9 registrado' exige construir isso antes, repetindo o erro da policy anterior."
    },
