    {
      "id": "apps_app_components_cosmos_design_painel_de_sinal_vivo",
      "label": "O Painel de Sinal Vivo (Cosmos creative north star)",
      "file_type": "rationale",
      "rationale": "Instrument-panel identity: number as protagonist, frame silent, colour reserved for data, 'sem sinal' instead of fake zero.",
      "source_file": "apps/app/components/cosmos/DESIGN.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null
    },
    {
      "id": "apps_app_components_cosmos_design_one_voice_rule",
      "label": "The One Voice Rule",
      "file_type": "rationale",
      "rationale": "Lavender is the only brand accent, marking place, action and focus only; no second accent (old cyan, shadcn blue) allowed.",
      "source_file": "apps/app/components/cosmos/DESIGN.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null
    },
    {
      "id": "apps_app_components_cosmos_design_tone_plus_word_rule",
      "label": "The Tone-Plus-Word Rule",
      "file_type": "rationale",
      "rationale": "State colour never stands alone; always paired with a Badge word or dot/pulse; green/red/amber exclusive to data surfaces.",
      "source_file": "apps/app/components/cosmos/DESIGN.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null
    },
    {
      "id": "apps_app_components_cosmos_design_scope_rule",
      "label": "The Scope Rule",
      "file_type": "rationale",
      "rationale": "Cosmos tokens only exist inside .cosmos-root; every portal must mount under that wrapper via CosmosPortal or inherit unscoped shadcn neutrals.",
      "source_file": "apps/app/components/cosmos/DESIGN.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null
    },
    {
      "id": "apps_app_components_cosmos_design_light_from_above_rule",
      "label": "The Light-From-Above Rule",
      "file_type": "rationale",
      "rationale": "In dark theme every elevated surface gets a 1px light edge at the top; depth comes from above, never a hard lateral shadow.",
      "source_file": "apps/app/components/cosmos/DESIGN.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null
    },
    {
      "id": "apps_app_components_cosmos_design_glow_is_data_rule",
      "label": "The Glow-Is-Data Rule",
      "file_type": "rationale",
      "rationale": "Coloured glow only appears on data surfaces (KPI, tone bar, progress, live switch) or the primary CTA, never on nav/field/text.",
      "source_file": "apps/app/components/cosmos/DESIGN.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null
    },
    {
      "id": "apps_app_components_cosmos_design_clean_light_rule",
      "label": "The Clean-Light Rule",
      "file_type": "rationale",
      "rationale": "Dot-grid, engraved watermark and ECG texture are dark-theme-only signatures; light theme hides them and has no whole-page grain.",
      "source_file": "apps/app/components/cosmos/DESIGN.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null
    },
    {
      "id": "apps_app_components_cosmos_design_mono_for_data_rule",
      "label": "The Mono-for-Data Rule",
      "file_type": "rationale",
      "rationale": "Every id, number, percentage, date and code goes in JetBrains Mono (.mono); Manrope on an id loses the signal that it is data.",
      "source_file": "apps/app/components/cosmos/DESIGN.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null
    },
    {
      "id": "apps_app_components_cosmos_design_six_steps_rule",
      "label": "The Six Steps Rule",
      "file_type": "rationale",
      "rationale": "New font size must come from the six-step scale (micro..display); half-pixel steps do not separate label from title.",
