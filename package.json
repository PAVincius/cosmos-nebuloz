{
  "name": "next-forge",
  "version": "5.3.2",
  "bin": {
    "next-forge": "dist/index.js"
  },
  "files": [
    "dist/index.js"
  ],
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev --filter=!docs --continue",
    "check": "npx ultracite@latest check",
    "fix": "npx ultracite@latest fix",
    "test": "turbo test",
    "test:coverage": "turbo test:coverage",
    "analyze": "turbo analyze",
    "translate": "turbo translate",
    "boundaries": "turbo boundaries",
    "knip": "DATABASE_URL=postgresql://placeholder:placeholder@localhost:5432/placeholder BETTER_AUTH_SECRET=knip-placeholder-nao-e-segredo-0123456789 knip --no-progress",
    "prepare": "simple-git-hooks",
    "generate:tests": "tsx scripts/generate-tests.ts",
    "fix:ci": "tsx scripts/fix-ci.ts",
    "risk:score": "tsx scripts/risk-score.ts",
    "audit:runtime": "tsx scripts/audit-runtime.mts",
    "size:guard": "tsx scripts/file-size-guard.mts",
    "legal:guard": "tsx scripts/legal-placeholders-guard.mts",
    "coverage:gaps": "tsx scripts/coverage-gaps.mts",
    "cosmos:graph": "tsx scripts/cosmos-graph.mts",
    "knowledge:refresh": "tsx scripts/knowledge/exportar.mts",
    "test:knowledge": "vitest run scripts/knowledge",
    "dark-matter": "tsx scripts/dark-matter.mts",
    "bump-deps": "npx npm-check-updates --deep -u -x recharts && pnpm install",
    "bump-ui": "npx shadcn@latest add --all --overwrite -c packages/design-system",
    "migrate": "cd packages/database && npx prisma format && npx prisma generate && npx prisma migrate deploy",
    "clean": "git clean -xdf node_modules",
    "mail:dev": "docker compose -f docker-compose.dev.yml up -d mailpit && echo \"Mailpit em http://localhost:8025 — SMTP em localhost:1025\"",
    "mail:stop": "docker compose -f docker-compose.dev.yml down"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged",
    "pre-push": "pnpm turbo test"
  },
  "lint-staged": {
    "*.{ts,mts,tsx,js,jsx}": [
      "biome check --write --no-errors-on-unmatched"
    ],
    "*.{json,jsonc}": [
      "biome format --write --no-errors-on-unmatched"
    ]
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.54.0",
    "@auto-it/first-time-contributor": "^11.3.6",
    "@biomejs/biome": "2.3.8",
    "@repo/typescript-config": "workspace:*",
    "@turbo/gen": "^2.6.3",
    "@types/node": "^24.10.1",
    "glob": "^11.0.2",
    "lint-staged": "^15.5.2",
    "simple-git-hooks": "^2.13.0",
    "tsup": "^8.5.1",
    "tsx": "^4.19.4",
    "turbo": "^2.6.3",
    "typescript": "^5.9.3",
    "ultracite": "6.3.9",
    "vitest": "^4.1.10",
    "zod": "4.1.13"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@10.24.0",
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "commander": "^14.0.2"
  },
  "pnpm": {
    "overrides": {
      "parse5": "^7.2.1",
      "zod@4": "4.1.13",
      "next": "16.2.9",
      "lodash": "^4.17.21",
      "basic-ftp": "^5.2.0",
      "handlebars": "^4.7.9",
      "webpack": "5.109.2",
      "react": "19.2.1",
      "react-dom": "19.2.1",
      "@types/react": "19.2.7",
      "@types/node": "^24.10.1",
      "typescript": "^5.9.3",
      "postcss": "^8.5.6",
      "vitest": "^4.1.10",
      "ai": "^5.0.202",
      "pg": "^8.20.0",
      "@types/pg": "^8.15.6"
    }
  },
  "type": "module"
}
