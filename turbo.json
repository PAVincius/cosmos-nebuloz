{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "ui": "tui",
  "envMode": "loose",
  "tasks": {
    "build": {
      "dependsOn": ["^build", "@repo/database#migrate:deploy"],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "**/generated/**",
        "storybook-static/**",
        ".react-email/**"
      ]
    },
    "@repo/database#migrate:deploy": {
      "cache": false,
      "env": ["DATABASE_URL", "DIRECT_URL", "DARK_MATTER_DB_HOST", "VERCEL_ENV"]
    },
    "docs#build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "../../docs/cliente/**"],
      "outputs": ["build/**"]
    },
    "docs-internal#build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "../../docs/produto/**"],
      "outputs": ["build/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck", "@repo/database#build"]
    },
    "test": {
      "dependsOn": ["^test"]
    },
    "app#test": {
      "dependsOn": ["@repo/database#build", "^test"]
    },
    "test:coverage": {
      "dependsOn": ["^test:coverage"],
      "outputs": ["coverage/**"]
    },
    "test:e2e": {
      "cache": false,
      "env": [
        "PLAYWRIGHT_BASE_URL",
        "AUTH_TEST",
        "E2E_EMAIL",
        "E2E_PASSWORD",
        "CI"
      ]
    },
    "analyze": {
      "dependsOn": ["^analyze"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "translate": {
      "dependsOn": ["^translate"],
      "cache": false
    },
    "clean": {
      "cache": false
    },
    "//#clean": {
      "cache": false
    }
  }
}
