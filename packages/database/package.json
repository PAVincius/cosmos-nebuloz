{
  "name": "@repo/database",
  "version": "0.0.0",
  "main": "./index.ts",
  "types": "./index.ts",
  "scripts": {
    "analyze": "prisma generate --no-hints",
    "build": "prisma generate --no-hints",
    "migrate:deploy": "tsx scripts/deploy-migrations.mts",
    "gerar:migrations": "tsx scripts/gerar-migrations-do-codigo.mts",
    "test": "vitest run",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false",
    "seed:safe": "tsx --env-file=.env seed-safe-full.ts",
    "seed:regulacao": "tsx scripts/seed-regulacao.mts",
    "seed:scaffold": "tsx scripts/seed-scaffold.mts",
    "seed:scaffold-demo": "tsx scripts/seed-scaffold-demo.mts",
    "seed:modelos": "tsx scripts/seed-modelos.mts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2",
    "@prisma/adapter-neon": "7.1.0",
    "@prisma/adapter-pg": "7.1.0",
    "@prisma/client": "7.1.0",
    "@prisma/client-runtime-utils": "^7.1.0",
    "@t3-oss/env-nextjs": "^0.13.8",
    "dotenv": "^17.4.2",
    "pg": "^8.16.0",
    "server-only": "^0.0.1",
    "undici": "^7.16.0",
    "ws": "^8.18.3",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "24.10.1",
    "@types/pg": "^8.11.14",
    "@types/ws": "^8.18.1",
    "better-auth": "^1.6.26",
    "bufferutil": "^4.0.9",
    "prisma": "7.1.0",
    "typescript": "^5.9.3"
  }
}
