// Flow Metrics & Measure-and-Grow — SAFe 6.0

model StateTransitionHistory {
  id             String   @id @default(cuid())
  tenantId       String
  entityType     String   // Story/Feature/Epic/Task/Defect
  entityId       String
  fromStatus     String
  toStatus       String
  transitionedAt DateTime @default(now())
  userId         String?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([entityId, transitionedAt])
  @@index([tenantId, entityType, entityId])
}

model FlowMetricSnapshot {
  id        String   @id @default(cuid())
  tenantId  String
  scope     String   // team / art / value_stream
  scopeId   String
  period    String   // sprint / pi / quarter
  periodRef String   // sprintId, piPlanId, or "2026-Q2"
  recordedAt DateTime @default(now())

  // Flow Distribution — JSON { story: N, defect: N, feature: N, enabler: N }
  flowDistribution Json @default("{}")

  // Flow Velocity
  flowVelocityTotal  Int  @default(0)
  flowVelocityByType Json @default("{}")

  // Flow Time (hours)
  flowTimeAvgHours    Float @default(0)
  flowTimeMedianHours Float @default(0)
  flowTimeByType      Json  @default("{}")

  // Flow Load (WIP)
  flowLoadAvg     Float @default(0)
  flowLoadCurrent Int   @default(0)

  // Flow Efficiency (0–1)
  flowEfficiency Float @default(0)

  // Flow Predictability (0–1)
  flowPredictability Float @default(0)
  plannedItems       Int   @default(0)
  deliveredItems     Int   @default(0)

  // S4: Staleness tracking
  staleness            String    @default("FRESH")  // FRESH / AGING / STALE / CRITICAL
  stalenessReasons     Json      @default("[]")      // string[] of rule names that fired
  lastStalenessCheck   DateTime?
  versionOf            String?   // self-referential FK to predecessor snapshot id
  isArchived           Boolean   @default(false)
  archivedAt           DateTime?
  reevaluatedBy        String?   // userId who triggered re-evaluation
  reevaluatedAt        DateTime?
  teamCompositionHash  String?   // SHA-256 of sorted member userId array at snapshot time

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, scope, scopeId])
  @@index([tenantId, periodRef])
  @@index([tenantId, staleness, lastStalenessCheck])
}

model CompetencyAssessment {
  id          String    @id @default(cuid())
  tenantId    String
  scope       String    // team / art / value_stream / portfolio
  scopeId     String
  // SAFe core competencies
  competency  String    // TEAM_TECHNICAL_AGILITY / AGILE_PRODUCT_DELIVERY /
                        // LEAN_PORTFOLIO_MANAGEMENT / ORGANIZATIONAL_AGILITY /
                        // ENTERPRISE_SOLUTION_DELIVERY / LEAN_AGILE_LEADERSHIP /
                        // CONTINUOUS_LEARNING_CULTURE
  score       Float     // 1–5
  assessedAt  DateTime  @default(now())
  assessedById String?
  respondents  Json?    // string[] userIds
  notes        String?  @db.Text
  piPlanId     String?

  tenant  Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actions ImprovementAction[]

  @@index([tenantId])
  @@index([tenantId, scope, scopeId])
  @@index([tenantId, competency])
}

model ImprovementAction {
  id            String    @id @default(cuid())
  tenantId      String
  title         String
  description   String?   @db.Text
  scope         String    // team / art / value_stream
  scopeId       String
  relatedMetric String?   // flow_velocity / flow_time / flow_load /
                          // flow_efficiency / flow_predictability / flow_distribution
  status        String    @default("OPEN") // OPEN / IN_PROGRESS / DONE / CANCELLED
  dueDate       DateTime?
  assigneeId    String?
  assessmentId  String?

  // S1: AI Copilot source tracking
  source        String?   // "manual" | "ai_copilot"
  sourceRunId   String?   // FK → AnomalyDetectionRun.id (set when source = "ai_copilot")

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant     Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assessment CompetencyAssessment? @relation(fields: [assessmentId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, scope, scopeId])
  @@index([tenantId, status])
  @@index([tenantId, source])
}

// S4: Audit trail for staleness state transitions
model StalenessAuditLog {
  id             String   @id @default(cuid())
  tenantId       String
  snapshotId     String   // FlowMetricSnapshot.id
  oldState       String   // FRESH / AGING / STALE / CRITICAL
  newState       String
  triggeredRules Json     // string[] — which staleness rules fired
  triggeredBy    String   // "system" | userId
  checkedAt      DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([snapshotId])
  @@index([tenantId, checkedAt])
}
