/// As cinco formas de trabalho do handoff de set/2026 (correcoes.pdf, seção 01).
/// O corte é pela forma do trabalho, não por setor: um chatbot de finanças e um
/// assistente de agronegócio são a mesma forma e compartilham método, métricas
/// e controles. A mesma chave organiza os três produtos:
///   Scaffold → template de trilha · Signal → modelo de medição ·
///   Charter → perfil de controle.
///
/// Um enum só, da plataforma. É o antigo `ScaffoldArchetype` renomeado
/// (decisão provisória do Norte, 2026-09-29, seção c.0): TRIAGE, DOC_REVIEW e
/// REPORTING mantêm o nome e o dado; CONVERSATIONAL e ANALYSIS são novos. As
/// colunas `ScaffoldTemplate.archetype` e `ScaffoldTrack.archetype` seguem com
/// o nome, só o tipo mudou. Acrescentar valor é migration nova.
enum WorkForm {
  /// Assistente conversacional — o público pergunta em volume, a resposta
  /// existe em fonte oficial.
  CONVERSATIONAL
  /// Análise e priorização — um score ordena casos para alguém decidir.
  ANALYSIS
  /// Revisão de documentos — lê contratos, laudos e prontuários e extrai o que
  /// importa.
  DOC_REVIEW
  /// Triagem de demanda — decide destino e urgência de pedidos.
  TRIAGE
  /// Relatórios recorrentes — gera conteúdo que sai da empresa ou vira registro.
  REPORTING
}
