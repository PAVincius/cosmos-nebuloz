// Wave 5 — Large Solution Level entities
// Story-039: extended with LACEMember, SupplierDeliverable, cross-ART relations
// Story-043: extended with SolutionRisk, CrossArtDependency

enum SolutionROAMStatus {
  RESOLVED
  OWNED
  ACCEPTED
  MITIGATED
}

enum CrossArtDependencyType {
  PROVIDES
  NEEDS
  BLOCKS
}

enum LACERole {
  SOLUTION_TRAIN_ENGINEER
  BUSINESS_OWNER
  ENTERPRISE_ARCHITECT
  SYSTEM_ARCHITECT
  PRODUCT_MANAGER
}

enum DeliverableStatus {
  PENDING
  IN_PROGRESS
  DELIVERED
  DELAYED
}

model SolutionTrain {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant        Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  capabilities  Capability[]
  solutionEpics SolutionEpic[]
  arts          ART[]
  suppliers     Supplier[]
  solutionRisks SolutionRisk[]
  crossArtDeps  CrossArtDependency[]

  @@index([tenantId])
}

model Capability {
  id              String   @id @default(cuid())
  tenantId        String
  solutionTrainId String?
  title           String
  description     String?
  status          String   @default("BACKLOG") // BACKLOG/ANALYZING/IMPLEMENTING/DONE
  order           Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  solutionTrain SolutionTrain? @relation(fields: [solutionTrainId], references: [id], onDelete: SetNull)
  features      Feature[]

  @@index([tenantId])
  @@index([solutionTrainId])
}

model SolutionEpic {
  id              String   @id @default(cuid())
  tenantId        String
  solutionTrainId String?
  title           String
  description     String?
  status          String   @default("BACKLOG")
  wsjfScore       Float    @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  solutionTrain SolutionTrain? @relation(fields: [solutionTrainId], references: [id], onDelete: SetNull)
  linkedEpics   Epic[]

  @@index([tenantId])
  @@index([solutionTrainId])
}

model LACE {
  id          String   @id @default(cuid())
  tenantId    String   @unique
  name        String
  description String?
  principles  Json     @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  laceMembers LACEMember[]
}

model LACEMember {
  id        String   @id @default(cuid())
  tenantId  String
  laceId    String
  userId    String
  laceRole  LACERole @default(PRODUCT_MANAGER)
  joinedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  lace LACE @relation(fields: [laceId], references: [id], onDelete: Cascade)

  @@unique([laceId, userId])
  @@index([tenantId])
  @@index([laceId])
}

model Supplier {
  id              String   @id @default(cuid())
  tenantId        String
  solutionTrainId String?
  artId           String?
  name            String
  contact         String?
  description     String?
  status          String   @default("ACTIVE") // ACTIVE/INACTIVE
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant        Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  solutionTrain SolutionTrain?        @relation(fields: [solutionTrainId], references: [id], onDelete: SetNull)
  deliverables  SupplierDeliverable[]

  @@index([tenantId])
  @@index([artId])
  @@index([solutionTrainId])
}

model SupplierDeliverable {
  id           String            @id @default(cuid())
  tenantId     String
  supplierId   String
  featureId    String
  expectedDate DateTime
  actualDate   DateTime?
  status       DeliverableStatus @default(PENDING)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  feature  Feature  @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@index([supplierId, status])
  @@index([tenantId])
}

model SolutionRisk {
  id              String             @id @default(cuid())
  tenantId        String
  solutionTrainId String
  title           String
  description     String?
  roamStatus      SolutionROAMStatus @default(RESOLVED)
  owner           String?
  affectedArtIds  String[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  solutionTrain SolutionTrain @relation(fields: [solutionTrainId], references: [id], onDelete: Cascade)
  tenant        Tenant        @relation(fields: [tenantId], references: [id])

  @@index([solutionTrainId, roamStatus])
  @@index([tenantId])
}

model CrossArtDependency {
  id              String                 @id @default(cuid())
  tenantId        String
  solutionTrainId String
  sourceFeatureId String
  targetFeatureId String
  sourceArtId     String
  targetArtId     String
  type            CrossArtDependencyType @default(NEEDS)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  solutionTrain SolutionTrain @relation(fields: [solutionTrainId], references: [id], onDelete: Cascade)
  tenant        Tenant        @relation(fields: [tenantId], references: [id])

  @@index([solutionTrainId])
  @@index([tenantId])
}
