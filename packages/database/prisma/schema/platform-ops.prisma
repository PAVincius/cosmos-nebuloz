/// Operação da Nebuloz: catálogo, propostas, engajamentos, capacidade, IP e
/// acesso ao painel.
///
/// Arquivo separado de `governance.prisma` de propósito: aquele é sobre o que a
/// plataforma controla nos clientes; este é sobre como a Nebuloz vende e
/// entrega. Misturar deixaria um arquivo em que ninguém acha nada.
///
/// Tudo aqui pertence ao tenant `system` — é dado da casa, não do cliente. O
/// `tenantId` existe pelo mesmo escopo e pela mesma trilha de auditoria que o
/// resto do painel usa.

// ─────────────────────────── Catálogo ───────────────────────────

/// O que a Nebuloz vende. É a origem dos itens de uma proposta e do que um
/// engajamento entrega — sem catálogo, proposta vira texto livre e não há eixo
/// para comparar um cliente com outro.
model Service {
  id       String @id @default(cuid())
  tenantId String

  /// Código curto do handoff ("SV-09"). Único por tenant porque é o que
  /// aparece em proposta e contrato — dois SV-09 tornariam o documento
  /// ambíguo justamente onde ele precisa ser exato.
  codigo    String
  nome      String
  descricao String? @db.Text

  /// PROJETO | RETAINER | LICENCA — como é cobrado, não o que é entregue.
  modalidade String @default("PROJETO")

  /// Preço de referência em centavos. Inteiro, não decimal: ponto flutuante em
  /// dinheiro acumula erro na soma dos itens, e o total da proposta é somado.
  precoBaseCentavos Int    @default(0)
  /// A que o preço se refere: "projeto", "mês", "usuário/mês".
  unidade           String @default("projeto")

  /// Fora de catálogo não some — some da lista de escolha. Proposta antiga
  /// continua apontando para o serviço que existia quando foi feita.
  ativo Boolean @default(true)

  /// readiness | adoption | enablement | custom — a trilha de consultoria.
  /// String pelo mesmo motivo de `modalidade`: trilha nova é INSERT, não
  /// migration.
  trilha String @default("readiness")

  /// PROJETO | SPRINT | HORA | RETAINER. Sucede `modalidade`, que só
  /// distinguia três casos e não dizia o que a fórmula precisa saber: se o
  /// serviço recorre. `RETAINER` é o único que entra na mensalidade; o resto
  /// cai no setup do projeto.
  unidadeDeCobranca String @default("PROJETO")

  /// "4 semanas", "por sprint de 2 semanas". Texto porque vai no documento do
  /// cliente, não em conta — duração aqui não multiplica preço.
  duracao String?

  /// O que o cliente recebe. Vira anexo da proposta.
  entregaveis String[] @default([])

  /// Papéis que a entrega aloca — dimensiona o time antes de prometer prazo.
  papeis String[] @default([])

  /// Códigos de serviços que este pressupõe. A proposta avisa quando um deles
  /// está fora do escopo, e não bloqueia: o cliente pode já ter o equivalente
  /// feito por outro fornecedor.
  preRequisitos String[] @default([])

  /// Módulo que este serviço deixa configurado, quando há. Nulo = serviço
  /// independente de licença, vendável sozinho.
  moduloVinculado ProductModule?

  /// Execução depende de capacidade no LAB — a proposta avisa antes de alguém
  /// prometer data.
  exigeLab Boolean @default(false)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  tenant      Tenant           @relation("ServiceSystemTenant", fields: [tenantId], references: [id], onDelete: Cascade)
  itens       ProposalItem[]
  engajamento Engagement[]
  ipServices  IpAssetService[]

  @@unique([tenantId, codigo])
  @@index([tenantId])
  @@index([tenantId, ativo])
}

// ─────────────────────────── Funil ───────────────────────────

/// A metade inicial do funil comercial: LEAD, DISCOVERY, EVALUATION. Os dois
/// estágios seguintes (proposta enviada, fechado) já têm onde morar — são
/// `Proposal.status`.
///
/// Modelo separado de Proposal, e não três estágios novos nela, por decisão:
/// `Proposal.numero` aparece em contrato, e gastar um número em lead que ainda
/// pode não virar nada corromperia um identificador que precisa ser exato. Um
/// Lead converte numa Proposal — ele não se torna uma.
model Lead {
  id       String @id @default(cuid())
  tenantId String

  /// Organização-alvo. Sem tenant ainda — é assim que se ganha o cliente,
  /// igual ao `clienteNome` de Proposal antes do aceite.
  nome String

  /// Contato do lado do prospect. Opcionais porque um lead nasce muitas vezes
  /// só com o nome da organização — o contato certo é parte do que se
  /// descobre no próprio estágio DISCOVERY.
  contatoNome  String?
  contatoEmail String?

  /// LEAD | DISCOVERY | EVALUATION | PROPOSAL. É gravado por
  /// `converterEmProposta`; nunca por `moverEstagio`.
  estagio String @default("LEAD")

  /// "Dias no estágio". Zera a cada mudança de `estagio`. Migration do funil
  /// v2 faz `UPDATE … SET "estagioDesde" = "criadoEm"` nas linhas existentes.
  estagioDesde DateTime @default(now())

  /// Porta de entrada na Escada (Meridian 01 … Cosmos 05). Nulo nos leads
  /// antigos.
  entrada ProductModule?

  /// De onde veio o lead. Texto livre: a lista de canais muda mais rápido do
  /// que uma migration acompanharia.
  origem String?

  /// Canal com CAC médio. `origem` (texto) fica como legado, só leitura.
  canalId String?

  /// Quem toca o lead. Nome ao lado do id pelo mesmo motivo de
  /// `criadoPorNome` em Proposal: a linha continua legível se a pessoa sair.
  donoId   String
  donoNome String?

  /// Sem isto um funil é uma lista morta: nada diz o que fazer a seguir nem
  /// quando. `proximaAcaoEm` é o que a tela usa para destacar atraso.
  proximaAcao   String?
  proximaAcaoEm DateTime?

  /// Valor até virar proposta; depois o valor é o ACV da proposta (uma
  /// verdade só).
  acvEstimadoCentavos Int?

  /// Vínculo de conversão. Único: uma proposta nasce de no máximo um lead, e
  /// duas linhas do funil apontando para o mesmo documento comercial seria o
  /// funil contando a mesma venda duas vezes. SetNull porque o lead é
  /// histórico do funil e não deve desaparecer se a proposta um dia sumir.
  propostaId String? @unique

  /// Preenchidos juntos: lead que sai sem dizer por quê não ensina nada sobre
  /// preço nem ICP para o próximo. `motivoPerda` guarda o código do motivo
  /// (PRECO, TIMING, SEM_SPONSOR, CONCORRENTE, SEM_FIT, OUTRO); linhas
  /// antigas com texto livre são lidas como OUTRO com o texto em `notaPerda`.
  perdidoEm   DateTime?
  motivoPerda String?

  /// Em que estágio a perda aconteceu — a tela mostra "Perdido · Aval.".
  perdidoNoEstagio String?

  /// O que aconteceu, mínimo 12 caracteres.
  notaPerda String? @db.Text

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  tenant    Tenant               @relation("LeadSystemTenant", fields: [tenantId], references: [id], onDelete: Cascade)
  proposta  Proposal?            @relation(fields: [propostaId], references: [id], onDelete: SetNull)
  canal     CanalDeLead?         @relation(fields: [canalId], references: [id], onDelete: SetNull)
  historico HistoricoDeEstagio[]
  /// Diagnósticos de maturidade feitos para este lead (degrau 01 da Escada).
  avaliacoes AvaliacaoDeMaturidade[]

  @@index([tenantId])
  @@index([tenantId, estagio])
}

/// Configuração de estágio do funil, por tenant. Peso e teto vêm daqui, não
/// de constante em código: mudar a fórmula sem registro é número que ninguém
/// aceita (design, backoffice-funnel-stage.jsx).
model EstagioDoFunil {
  id       String @id @default(cuid())
  tenantId String

  /// LEAD | DISCOVERY | EVALUATION | PROPOSAL
  codigo String

  pesoPercent Int
  tetoDias    Int

  /// Critérios de saída, um por linha.
  criterios String[] @default([])

  /// Ordem de exibição no board — mesmo papel de `ordem` em `CanalDeLead`.
  ordem Int @default(0)

  atualizadoEm DateTime @updatedAt

  tenant Tenant @relation("EstagioDoFunilSystemTenant", fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, codigo])
}

/// Append-only. Mudar o peso muda o pipeline ponderado; fórmula que muda sem
/// registro é número que ninguém aceita (design, backoffice-funnel-stage.jsx).
model MudancaDeEstagio {
  id       String @id @default(cuid())
  tenantId String
  codigo   String

  /// PESO | TETO | CRITERIOS
  campo String

  de     String
  para   String
  motivo String @db.Text

  autorId   String
  autorNome String?

  criadoEm DateTime @default(now())

  tenant Tenant @relation("MudancaDeEstagioSystemTenant", fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, codigo, criadoEm])
}

/// Canal de aquisição do lead, com CAC médio — o que `origem` (texto livre em
/// `Lead`) não sustentava.
model CanalDeLead {
  id       String @id @default(cuid())
  tenantId String
  slug     String
  nome     String

  /// CAC médio do canal em centavos. Nulo = ainda não medido — a tela mostra
  /// "CAC —" e não soma. Sem chute.
  cacMedioCentavos Int?

  ativo Boolean @default(true)
  ordem Int     @default(0)

  tenant Tenant @relation("CanalDeLeadSystemTenant", fields: [tenantId], references: [id], onDelete: Cascade)
  leads  Lead[]

  @@unique([tenantId, slug])
}

/// Uma linha por transição (inclusive entrada em LEAD, conversão e perda).
/// É o que sustenta "conversão 90 d" e "permanência média" do painel.
model HistoricoDeEstagio {
  id       String  @id @default(cuid())
  tenantId String
  leadId   String
  de       String?

  /// LEAD | DISCOVERY | EVALUATION | PROPOSAL | GANHO | PERDIDO
  para String

  em DateTime @default(now())

  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  tenant Tenant @relation("HistoricoDeEstagioSystemTenant", fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, para, em])
  @@index([leadId])
}

// ─────────────────────────── Propostas ───────────────────────────

/// Proposta comercial para um cliente.
///
/// O gate de desconto do handoff mora aqui: acima de 15% a proposta não é
/// enviada no clique — ela entra na fila de PlatformApproval, a mesma das
/// operações sensíveis do painel.
model Proposal {
  id       String @id @default(cuid())
  tenantId String

  numero String
  titulo String

  /// Cliente destinatário. Opcional porque proposta nasce antes do tenant
  /// existir — é assim que se ganha o cliente. SetNull para a proposta
  /// sobreviver à saída dele: histórico comercial não some junto.
  clienteTenantId String?
  /// Nome do prospect enquanto não há tenant. Sem isto, proposta sem cliente
  /// vinculado apareceria na lista sem dizer para quem é.
  clienteNome     String?

  /// RASCUNHO | AGUARDANDO_APROVACAO | ENVIADA | ACEITA | RECUSADA
  status String @default("RASCUNHO")

  /// Percentual, 0 a 100. Acima de LIMITE_DESCONTO_SEM_APROVACAO exige
  /// aprovação — ver app/actions/proposals.ts.
  descontoPercent Int @default(0)

  /// Congelado no envio, não recalculado na leitura: preço de catálogo muda, e
  /// uma proposta que muda de valor sozinha depois de enviada é um problema
  /// contratual, não um detalhe de exibição.
  totalCentavos Int @default(0)

  /// ── Escopo de assinatura ────────────────────────────────────────────────
  /// Guardado na proposta e não derivado do tenant: a proposta existe antes do
  /// tenant, e o escopo é justamente o que está sendo negociado. Nulo nas
  /// propostas anteriores a este campo, que seguem valendo só pelos itens.
  planoSlug String?
  assentos  Int     @default(0)

  /// Módulos escolhidos. Lista e não tabela-ponte porque não há atributo por
  /// linha — é escolha, não relação com dados próprios.
  modulos ProductModule[] @default([])

  /// Slugs de `AddOnComercial` e de `TermoDeContrato`. Slug e não FK: o
  /// catálogo pode ser reorganizado, e a proposta enviada continua dizendo o
  /// que foi vendido mesmo que a linha de catálogo mude de id.
  addOnSlugs String[] @default([])
  termoSlug  String?

  /// Congelados junto de `totalCentavos`, pelo mesmo motivo. ACV e TCV são o
  /// que o pipeline soma; recalculá-los na leitura faria o funil mudar de
  /// tamanho sozinho quando alguém mexesse no preço de tabela.
  acvCentavos    Int @default(0)
  tcvCentavos    Int @default(0)
  umaVezCentavos Int @default(0)

  /// Destinatário da proposta — FR-13.7 exige e-mail válido para enviar.
  contatoEmail String?

  /// Slug do tenant que nasceu desta proposta, quando ela virou cliente.
  /// Fecha o elo comercial → operação sem redigitar escopo.
  tenantProvisionadoSlug String?

  /// Aprovação que destravou o desconto, quando houve.
  aprovacaoId String?

  criadoPorId   String
  criadoPorNome String?
  criadoEm      DateTime @default(now())
  atualizadoEm  DateTime @updatedAt

  tenant Tenant         @relation("ProposalSystemTenant", fields: [tenantId], references: [id], onDelete: Cascade)
  itens  ProposalItem[]
  /// Lead que converteu nesta proposta, quando houve. Nulo nas propostas
  /// criadas direto pelo gerador, sem passar pelo funil.
  lead   Lead?

  @@unique([tenantId, numero])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([clienteTenantId])
}

/// Uma linha da proposta.
///
/// `precoUnitCentavos` é cópia, não referência: o preço do catálogo muda com o
/// tempo, e reler dali faria uma proposta assinada mudar de valor
/// retroativamente.
model ProposalItem {
  id         String @id @default(cuid())
  proposalId String
  serviceId  String

  /// Nome no momento da proposta, pelo mesmo motivo do preço.
  descricao         String
  quantidade        Int    @default(1)
  precoUnitCentavos Int    @default(0)
  ordem             Int    @default(0)

  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  service  Service  @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@index([proposalId])
  @@index([serviceId])
}

// ─────────────────────── Delivery ───────────────────────

/// Contrato de serviço em execução, por ESCOPO FECHADO.
///
/// Escopo fechado, não alocação: o valor e a entrega são acordados na
/// assinatura e não variam com as horas gastas. É por isso que não há campo de
/// hora aqui — quem mede esforço é a alocação de pessoa, e ela serve para saber
/// se o escopo cabe, não para faturar.
model Engagement {
  id       String @id @default(cuid())
  tenantId String

  nome   String
  codigo String

  /// Cliente atendido. Restrict, não Cascade: apagar um cliente com
  /// engajamento em curso deve falhar e obrigar a decisão explícita.
  clienteTenantId String
  serviceId       String?

  /// O que foi acordado entregar. Texto porque escopo é prosa negociada, não
  /// campo estruturado — estruturar aqui obrigaria a inventar taxonomia.
  escopo String? @db.Text

  /// PROPOSTO | ATIVO | PAUSADO | CONCLUIDO | CANCELADO
  status String @default("PROPOSTO")

  inicioEm DateTime?
  fimEm    DateTime?

  valorCentavos Int @default(0)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  tenant    Tenant            @relation("EngagementSystemTenant", fields: [tenantId], references: [id], onDelete: Cascade)
  service   Service?          @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  alocacoes StaffAllocation[]
  ipUsados  IpAsset[]
  ipReuses  IpAssetReuse[]

  @@unique([tenantId, codigo])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([clienteTenantId])
  @@index([serviceId])
}

/// Pessoa da equipe da Nebuloz.
///
/// Capacidade é POR PESSOA, não por papel: a equipe é multidisciplinar e a
/// maioria é fullstack. Modelar por papel obrigaria a inventar um papel
/// principal para cada um e perderia exatamente a flexibilidade que existe.
/// As habilidades ficam numa lista justamente para descrever quem faz o quê
/// sem reduzir ninguém a um rótulo.
model StaffPerson {
  id       String @id @default(cuid())
  tenantId String

  nome  String
  email String

  /// Ex.: ["frontend", "backend", "dados"]. Lista porque quase todo mundo tem
  /// mais de uma.
  habilidades String[] @default([])

  /// Horas por semana disponíveis para alocação. Base do cálculo de quanto
  /// ainda cabe.
  horasSemana Int @default(40)

  /// Quando esta capacidade entra no plano. Nulo = conta desde sempre.
  entraEm DateTime?

  /// Fim da janela de contrato. Nulo = sem fim previsto. Ter data de saída é o
  /// que distingue capacidade temporária (terceiro) da permanente — não existe
  /// coluna separada dizendo "é terceiro", porque duas fontes para o mesmo
  /// fato divergem na primeira edição.
  saiEm DateTime?

  /// Nota livre exibida na linha da pessoa. Ex.: "metade do tempo em gestão".
  observacao String?

  ativo Boolean @default(true)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  tenant          Tenant            @relation("StaffPersonSystemTenant", fields: [tenantId], references: [id], onDelete: Cascade)
  alocacoes       StaffAllocation[]
  assetsQueMantem IpAsset[]         @relation("IpAssetDono")

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([tenantId, ativo])
}

/// Quanto de uma pessoa está comprometido com um engajamento, num período.
///
/// Percentual e não horas absolutas: o denominador é `horasSemana` da pessoa, e
/// guardar horas aqui faria a soma mentir quando alguém muda de carga.
model StaffAllocation {
  id           String @id @default(cuid())
  personId     String
  engagementId String

  percentual Int       @default(0)
  inicioEm   DateTime
  fimEm      DateTime?

  nota String? @db.Text

  criadoEm DateTime @default(now())

  person     StaffPerson @relation(fields: [personId], references: [id], onDelete: Cascade)
  engagement Engagement  @relation(fields: [engagementId], references: [id], onDelete: Cascade)

  @@index([personId])
  @@index([engagementId])
  @@index([personId, inicioEm])
}

// ─────────────────────── Biblioteca de IP ───────────────────────

/// Ativo reutilizável entre engajamentos: template, playbook, componente.
///
/// Versionado do mesmo jeito que os diagramas, e pelo mesmo motivo: o valor de
/// um ativo está em saber o que mudou entre a v3 e a v4 quando ele é reusado
/// num cliente novo.
model IpAsset {
  id       String @id @default(cuid())
  tenantId String

  nome      String
  slug      String
  /// ACELERADOR | PLAYBOOK | TEMPLATE | EVAL_HARNESS | MODELO_BPMN | DOCUMENTO
  tipo      String  @default("DOCUMENTO")
  descricao String? @db.Text

  /// Conteúdo atual. O histórico completo fica em IpAssetVersion.
  conteudo String @db.Text

  /// Endereço onde o ativo vive de verdade ("repo/…", "notion/…", "drive/…").
  /// NULO É SIGNIFICATIVO: quer dizer que ele vive aqui, no editor deste
  /// catálogo. Não existe coluna "vive aqui" porque o nulo já é essa
  /// informação, e duas fontes para o mesmo fato divergem.
  link String?

  /// Quem MANTÉM o ativo, que não é quem o criou. `criadoPorId` continua
  /// existindo e responde a outra pergunta. SetNull: pessoa sai da casa, o
  /// ativo fica sem dono até alguém assumir — some o dono, não o ativo.
  donoPersonId String?

  /// INTERNO | ENGAJAMENTO | LAB | TERCEIRO — de onde ele veio, que é o que
  /// decide se existe direito de reuso.
  procedencia String @default("INTERNO")

  /// Cláusula de reuso conferida no contrato. Só significa algo quando
  /// `procedencia` é ENGAJAMENTO: sem ela, o artefato é IP do cliente e
  /// registrá-lo aqui cria passivo, não ativo.
  reusoConfirmado Boolean @default(false)

  /// NENHUMA | PERMISSIVA | COPYLEFT | COMERCIAL | NAO_RESOLVIDA
  licenca String @default("NENHUMA")

  /// Número da licença ou componente e versão. Obrigatório em COPYLEFT e
  /// COMERCIAL: um copyleft sem dizer qual componente não permite revisar
  /// nada antes de vender.
  licencaRef String?

  /// Engajamento de onde o ativo saiu. SetNull: o ativo sobrevive ao
  /// engajamento — é conhecimento que fica na casa.
  origemEngagementId String?

  criadoPorId   String
  criadoPorNome String?
  criadoEm      DateTime @default(now())
  atualizadoEm  DateTime @updatedAt

  tenant   Tenant           @relation("IpAssetSystemTenant", fields: [tenantId], references: [id], onDelete: Cascade)
  origem   Engagement?      @relation(fields: [origemEngagementId], references: [id], onDelete: SetNull)
  versions IpAssetVersion[]
  dono     StaffPerson?     @relation("IpAssetDono", fields: [donoPersonId], references: [id], onDelete: SetNull)
  servicos IpAssetService[]
  reusos   IpAssetReuse[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([tenantId, tipo])
  @@index([origemEngagementId])
  @@index([donoPersonId])
}

/// Revisão de um ativo. Append-only, igual ao StaffDiagramVersion.
model IpAssetVersion {
  id       String  @id @default(cuid())
  assetId  String
  versao   Int
  conteudo String  @db.Text
  nota     String? @db.Text

  autorId   String
  autorNome String?
  criadoEm  DateTime @default(now())

  asset IpAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([assetId, versao])
  @@index([assetId])
}

/// Que serviços este ativo encurta. Sem vínculo, o ativo não aparece na hora
/// de montar proposta — que é onde ele paga.
///
/// Sem `tenantId` e sem RLS, como `IpAssetVersion`: alcança-se só pelo pai, e o
/// pai é isolado.
model IpAssetService {
  assetId   String
  serviceId String

  asset   IpAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([assetId, serviceId])
  @@index([serviceId])
}

/// Um reuso do ativo num engajamento. É a fonte de reusos, horas poupadas e
/// maturidade — nenhum dos três é digitado em lugar nenhum.
///
/// `@@unique([assetId, engagementId])` porque "foi reusado no EN-041" é um
/// fato, não um contador: registrar duas vezes contaria o mesmo reuso duas
/// vezes, e o número da tela deixaria de ser verificável.
model IpAssetReuse {
  id           String @id @default(cuid())
  assetId      String
  engagementId String

  /// Horas que este reuso poupou em relação a fazer do zero. Fica no evento,
  /// não no ativo: uma média guardada no ativo e multiplicada pela contagem
  /// seria uma segunda fonte para o mesmo número, e um reuso difícil não
  /// poderia contar diferente de um fácil.
  horasPoupadas Int     @default(0)
  nota          String? @db.Text

  registradoPorId   String
  registradoPorNome String?
  criadoEm          DateTime @default(now())

  asset      IpAsset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  engagement Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)

  @@unique([assetId, engagementId])
  @@index([assetId])
  @@index([engagementId])
}

// ─────────────────────── Acesso ao painel ───────────────────────

/// Quem entrou no back-office, quando e de onde (FR-30 do protótipo).
///
/// Separado do AuditLog de propósito: aquele registra o que se FEZ num tenant;
/// este registra o acesso ao painel em si, inclusive tentativa recusada. Juntar
/// os dois faria a trilha de um cliente encher de linha de login que não tem
/// nada a ver com ele.
model AccessLog {
  id       String @id @default(cuid())
  tenantId String

  userId String?
  email  String

  /// LOGIN | LOGOUT | RECUSADO
  evento String

  /// Preenchido quando `evento` é RECUSADO — sem o motivo, a linha diz que
  /// alguém não entrou e não ajuda ninguém a decidir o que fazer.
  motivo String?

  ip        String?
  userAgent String? @db.Text

  criadoEm DateTime @default(now())

  tenant Tenant @relation("AccessLogSystemTenant", fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, criadoEm])
  @@index([email])
}

// ─────────────────── Growth · maturidade de IA ───────────────────

/// Uma avaliação de maturidade de IA de uma organização — o diagnóstico que a
/// Nebuloz vende no degrau 01 da Escada (Meridian).
///
/// `organizacao` é texto e não `tenantId` pelo mesmo motivo de `Lead.nome`: a
/// avaliação é justamente o que se faz *antes* de a organização virar cliente.
/// Quando ela nasce do funil, `leadId` liga as duas pontas — e é assim que o
/// diagnóstico deixa de ser PDF solto e passa a justificar por qual degrau o
/// lead entra.
model AvaliacaoDeMaturidade {
  id       String @id @default(cuid())
  tenantId String

  organizacao String
  leadId      String?

  /// Versão da rubrica que pontuou esta avaliação. Existe porque a rubrica é
  /// IP da Nebuloz e vai evoluir: sem carimbar a versão, mudar um peso amanhã
  /// reescreveria em silêncio o score que já foi apresentado ao cliente.
  rubricaVersao String

  /// RASCUNHO | CONCLUIDA. Rascunho aceita resposta; concluída, não.
  status String @default("RASCUNHO")

  /// 0-100 e o nível derivado dele (INICIAL … OTIMIZADO). Gravados no fecho,
  /// não recalculados na leitura: o número que o cliente viu é o que fica,
  /// mesmo depois de a rubrica mudar. Nulos enquanto rascunho — "sem número,
  /// sem chute", a mesma regra do CAC.
  scoreGeral Int?
  nivelGeral String?

  concluidaEm DateTime?

  /// Quem conduziu. Nome ao lado do id pelo mesmo motivo de `criadoPorNome` em
  /// Proposal: a linha continua legível se a pessoa sair.
  autorId   String
  autorNome String?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  tenant    Tenant                 @relation("AvaliacaoDeMaturidadeSystemTenant", fields: [tenantId], references: [id], onDelete: Cascade)
  lead      Lead?                  @relation(fields: [leadId], references: [id], onDelete: SetNull)
  respostas RespostaDeMaturidade[]

  @@index([tenantId, status])
  @@index([tenantId, criadoEm])
}

/// Uma linha por critério respondido.
///
/// Linha e não JSON porque a pergunta que paga a conta é cross-organização
/// ("qual critério é o mais fraco da carteira?"), e isso é agregação sobre
/// coluna — não desempacote de documento em cada leitura.
model RespostaDeMaturidade {
  id          String @id @default(cuid())
  avaliacaoId String

  /// Repetido da avaliação-mãe, como `HistoricoDeEstagio` repete o do lead: a
  /// policy de RLS desta casa é `"tenantId" = current_tenant_id()`, e uma
  /// tabela sem a coluna ficaria fora do isolamento por não caber na regra.
  tenantId String

  /// Id do critério na rubrica (`estrategia.patrocinio`, …). Texto e não enum:
  /// a rubrica versiona em código, e um enum no banco pediria migration a cada
  /// critério novo — exatamente o acoplamento que `rubricaVersao` evita.
  criterioId String

  /// 0 (Inicial) … 4 (Otimizado), escala MITRE.
  nivel Int

  /// Evidência do avaliador. É o que separa diagnóstico de chute — e é o que
  /// o relatório cita quando o sponsor pergunta "por que nível 1?".
  nota String? @db.Text

  atualizadoEm DateTime @updatedAt

  avaliacao AvaliacaoDeMaturidade @relation(fields: [avaliacaoId], references: [id], onDelete: Cascade)
  tenant    Tenant                @relation("RespostaDeMaturidadeSystemTenant", fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([avaliacaoId, criterioId])
  @@index([tenantId])
}

// ─────────────────── AI Law Watch ───────────────────

/// Uma lei/PL de IA brasileira já vista pelo cron diário que monitora a API
/// AI Law Tracker. Guarda o suficiente para reportar "o que é novo desde a
/// última rodada" — não é um espelho completo do registro do provedor.
///
/// `identifier` é a chave estável do provedor (ex: "br-lei-15123-2025"), não
/// `id` deles: aquele é um uuid interno que pode mudar sem aviso, e dedupar
/// por ele faria o mesmo PL reaparecer como "novo" a cada rotação.
model AiLawWatchRecord {
  id           String @id @default(cuid())
  tenantId     String
  source       String // "ai-law-tracker"
  jurisdiction String // "brazil"
  identifier   String // campo estável do provedor — NÃO o uuid interno deles

  title       String  @db.Text
  recordType  String?
  inForce     Boolean
  officialUrl String

  firstSeenAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation("AiLawWatchRecordSystemTenant", fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, source, jurisdiction, identifier])
  @@index([tenantId, source, jurisdiction])
}
