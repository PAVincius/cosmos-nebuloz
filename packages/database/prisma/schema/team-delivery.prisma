// Wave 1 — Team Level delivery entities

model Sprint {
  id         String   @id @default(cuid())
  tenantId   String
  teamId     String
  piPlanId   String?
  name       String
  goal       String?
  startDate  DateTime
  endDate    DateTime
  status     String   @default("PLANNING") // PLANNING/ACTIVE/REVIEW/CLOSED
  isIPSprint Boolean  @default(false)
  capacity   Int?
  velocity   Int? // computed at sprint close
  closedAt   DateTime?
  // Story-022 overcommitment fields
  overcommitmentOverride        Boolean @default(false)
  overcommitmentJustification   String? @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant            Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  team              Team                   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  piPlan            PIPlan?                @relation(fields: [piPlanId], references: [id], onDelete: SetNull)
  stories           Story[]
  review            SprintReview?
  retro             Retrospective?
  memberAssignments TeamMemberAssignment[]
  memberMetrics     MemberSprintMetrics[]
  capacitySnapshots TeamCapacitySnapshot[]

  @@index([tenantId])
  @@index([teamId])
  @@index([piPlanId])
  @@index([tenantId, status])
}

model Story {
  id                 String    @id @default(cuid())
  tenantId           String
  sprintId           String?
  featureId          String?
  title              String
  description        String?   @db.Text
  acceptanceCriteria String?   @db.Text
  storyPoints        Int       @default(1)
  status             String    @default("BACKLOG") // BACKLOG/TODO/IN_PROGRESS/REVIEW/DONE/SPLIT_INTO
  priority           String    @default("medium") // critical/high/medium/low
  assigneeUserId     String?
  order              Int       @default(0)
  startedAt          DateTime? // set when status transitions to IN_PROGRESS
  completedAt        DateTime?
  // Story-021 split + decomposition fields
  origin             String    @default("MANUAL") // MANUAL/COPILOT_SUGGESTION
  originStoryId      String?
  splitIntoStoryIds  Json      @default("[]")

  // External integration fields
  externalId     String?
  externalSource String? // linear | github | asana | gitlab
  externalUrl    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sprint  Sprint?  @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  feature Feature? @relation(fields: [featureId], references: [id], onDelete: SetNull)
  tasks   Task[]

  @@index([tenantId])
  @@index([sprintId])
  @@index([featureId])
  @@index([tenantId, status])
  @@index([externalSource, externalId])
}

model Task {
  id             String    @id @default(cuid())
  tenantId       String
  storyId        String
  title          String
  description    String?
  status         String    @default("TODO") // TODO/IN_PROGRESS/DONE
  assigneeUserId String?
  estimateHours  Float?
  completedAt    DateTime?

  // S3: Synergy detection — task classification
  taskType    String? // backend | frontend | ml | infra | qa | data | design
  complexity  String? // low | medium | high
  estimatedSp Int?
  actualSp    Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  story     Story          @relation(fields: [storyId], references: [id], onDelete: Cascade)
  assignees TaskAssignee[]

  @@index([tenantId])
  @@index([storyId])
}

model Defect {
  id             String    @id @default(cuid())
  tenantId       String
  teamId         String?
  storyId        String?
  title          String
  description    String?   @db.Text
  severity       String    @default("medium") // critical/high/medium/low
  status         String    @default("OPEN") // OPEN/IN_PROGRESS/RESOLVED/CLOSED
  reporterUserId String?
  assigneeUserId String?
  resolvedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([teamId])
  @@index([tenantId, status])
}

model Impediment {
  id          String    @id @default(cuid())
  tenantId    String
  teamId      String?
  title       String
  description String?   @db.Text
  status      String    @default("OPEN") // OPEN/IN_PROGRESS/RESOLVED
  ownerUserId String?
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([teamId])
}

model StandupEntry {
  id        String   @id @default(cuid())
  tenantId            String
  teamId              String
  userId              String
  date                DateTime @db.Date
  yesterday           String?  @db.Text
  today               String?  @db.Text
  blockers            String?  @db.Text
  // Story-022 blocker→impediment link
  linkedImpedimentId  String?
  createdAt           DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId, date])
  @@index([tenantId])
  @@index([teamId, date])
}

model SprintReview {
  id        String   @id @default(cuid())
  tenantId  String
  sprintId  String   @unique
  velocity  Int?
  demoNotes String?  @db.Text
  goalMet   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sprint Sprint @relation(fields: [sprintId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model Retrospective {
  id        String   @id @default(cuid())
  tenantId  String
  sprintId  String   @unique
  wentWell  Json     @default("[]")
  toImprove Json     @default("[]")
  actions   Json     @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sprint Sprint @relation(fields: [sprintId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

// S3: Multi-assignee support for synergy detection
// Task.assigneeUserId kept for backward compatibility (primary assignee).
model TaskAssignee {
  taskId   String
  userId   String
  role     String? // primary | reviewer | pair
  joinedAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@index([userId])
  @@index([taskId])
}
