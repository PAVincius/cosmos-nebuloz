// Wave 1 — Team Level delivery entities

model Sprint {
  id         String   @id @default(cuid())
  tenantId   String
  teamId     String
  piPlanId   String?
  name       String
  goal       String?
  startDate  DateTime
  endDate    DateTime
  status     String   @default("PLANNING") // PLANNING/ACTIVE/REVIEW/CLOSED
  isIPSprint Boolean  @default(false)
  capacity   Int?
  velocity   Int? // computed at sprint close
  closedAt   DateTime?
  // Story-022 overcommitment fields
  overcommitmentOverride        Boolean @default(false)
  overcommitmentJustification   String? @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant            Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  team              Team                   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  piPlan            PIPlan?                @relation(fields: [piPlanId], references: [id], onDelete: SetNull)
  stories           Story[]
  review            SprintReview?
  retro             Retrospective?
  memberAssignments TeamMemberAssignment[]
  memberMetrics     MemberSprintMetrics[]
  capacitySnapshots TeamCapacitySnapshot[]

  @@index([tenantId])
  @@index([teamId])
  @@index([piPlanId])
  @@index([tenantId, status])
}

model Story {
  id                 String    @id @default(cuid())
  tenantId           String
  sprintId           String?
  featureId          String?
  title              String
  description        String?   @db.Text
  acceptanceCriteria String?   @db.Text
  storyPoints        Int       @default(1)
  status             String    @default("BACKLOG") // BACKLOG/TODO/IN_PROGRESS/REVIEW/DONE/SPLIT_INTO
  priority           String    @default("medium") // critical/high/medium/low
  assigneeUserId     String?
  order              Int       @default(0)
  startedAt          DateTime? // set when status transitions to IN_PROGRESS
  completedAt        DateTime?
  // Story-021 split + decomposition fields
  origin             String    @default("MANUAL") // MANUAL/COPILOT_SUGGESTION
  originStoryId      String?
  splitIntoStoryIds  Json      @default("[]")

  // External integration fields
  externalId     String?
  externalSource String? // linear | github | asana | gitlab
  externalUrl    String?

  // Story-025 GitHub PR linking
  prStatus String? // OPEN | MERGED | CLOSED
  prUrl    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sprint  Sprint?  @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  feature Feature? @relation(fields: [featureId], references: [id], onDelete: SetNull)
  tasks   Task[]

  @@index([tenantId])
  @@index([sprintId])
  @@index([featureId])
  @@index([tenantId, status])
  @@index([externalSource, externalId])
}

model Task {
  id             String    @id @default(cuid())
  tenantId       String
  storyId        String
  title          String
  description    String?
  status         String    @default("TODO") // TODO/IN_PROGRESS/DONE
  assigneeUserId String?
  estimateHours  Float?
  completedAt    DateTime?

  // S3: Synergy detection — task classification
  taskType    String? // backend | frontend | ml | infra | qa | data | design
  complexity  String? // low | medium | high
  estimatedSp Int?
  actualSp    Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  story     Story          @relation(fields: [storyId], references: [id], onDelete: Cascade)
  assignees TaskAssignee[]

  @@index([tenantId])
  @@index([storyId])
}

model Defect {
  id             String    @id @default(cuid())
  tenantId       String
  teamId         String?
  sprintId       String?
  storyId        String?
  title          String
  description    String?   @db.Text
  severity       String    @default("medium") // critical/high/medium/low
  status         String    @default("OPEN") // OPEN/IN_PROGRESS/IN_REVIEW/CLOSED
  reporterUserId String?
  assigneeUserId String?
  resolvedAt     DateTime?
  // Story-024 fields
  originSprintId String?
  reopenReason   String?   @db.Text
  isStale        Boolean   @default(false)
  staleAt        DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([teamId])
  @@index([tenantId, status])
  @@index([sprintId])
}

model Impediment {
  id             String    @id @default(cuid())
  tenantId       String
  teamId         String?
  artId          String?
  title          String
  description    String?   @db.Text
  status         String    @default("OPEN") // OPEN/ESCALATED/RESOLVED
  ownerUserId    String?
  resolvedAt     DateTime?
  // Story-024 escalation fields
  linkedRiskId   String?
  resolutionNote String?   @db.Text
  resolutionTime Float?    // hours from createdAt to resolvedAt
  severity       Int       @default(3) // 1-5
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([teamId])
  @@index([tenantId, status])
}

model StandupEntry {
  id        String   @id @default(cuid())
  tenantId            String
  teamId              String
  userId              String
  date                DateTime @db.Date
  yesterday           String?  @db.Text
  today               String?  @db.Text
  blockers            String?  @db.Text
  // Story-022 blocker→impediment link
  linkedImpedimentId  String?
  createdAt           DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId, date])
  @@index([tenantId])
  @@index([teamId, date])
}

model SprintReview {
  id              String   @id @default(cuid())
  tenantId        String
  sprintId        String   @unique
  velocity        Int?
  // Story-023 accepted vs completed guard (AC-001)
  completedPoints Int?
  acceptedPoints  Int?
  // Story-024 defect swimlane excluded from velocity (AC-007)
  defectCount     Int  @default(0)
  demoNotes       String?  @db.Text
  goalMet         Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sprint Sprint @relation(fields: [sprintId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model Retrospective {
  id              String    @id @default(cuid())
  tenantId        String
  sprintId        String    @unique
  teamId          String?
  wentWell        Json      @default("[]")
  toImprove       Json      @default("[]")
  actions         Json      @default("[]")
  // Story-023 phase tracking
  phase           String    @default("INPUT") // INPUT/VOTING/ACTION_PLANNING/CLOSED
  status          String    @default("DRAFT") // DRAFT/ACTIVE/CLOSED
  anonymousInput  Boolean   @default(true)
  votesPerMember  Int       @default(3)
  closedAt        DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sprint      Sprint            @relation(fields: [sprintId], references: [id], onDelete: Cascade)
  items       RetroItem[]
  actionItems RetroActionItem[]

  @@index([tenantId])
  @@index([teamId])
}

// Story-023 retro item with anonymous author support
model RetroItem {
  id        String   @id @default(cuid())
  tenantId  String
  retroId   String
  category  String   @default("WENT_WELL") // WENT_WELL/TO_IMPROVE
  text      String   @db.Text
  authorId  String?
  voteCount Int      @default(0)
  createdAt DateTime @default(now())

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  retro      Retrospective @relation(fields: [retroId], references: [id], onDelete: Cascade)
  votes      RetroVote[]

  @@index([tenantId])
  @@index([retroId])
}

// Story-023 per-member vote tracking for dot voting
model RetroVote {
  itemId    String
  userId    String
  createdAt DateTime @default(now())

  item RetroItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@id([itemId, userId])
  @@index([userId])
}

// Story-023 action items with carry-forward lineage
model RetroActionItem {
  id                 String    @id @default(cuid())
  tenantId           String
  retroId            String
  title              String
  ownerId            String
  dueDate            DateTime
  status             String    @default("OPEN") // OPEN/COMPLETE
  carriedFromRetroId String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  retro  Retrospective @relation(fields: [retroId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([retroId])
}

// S3: Multi-assignee support for synergy detection
// Task.assigneeUserId kept for backward compatibility (primary assignee).
model TaskAssignee {
  taskId   String
  userId   String
  role     String? // primary | reviewer | pair
  joinedAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@index([userId])
  @@index([taskId])
}
