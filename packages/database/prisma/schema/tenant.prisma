  scaffoldSequences        ScaffoldSequence[]
  scaffoldSettings         ScaffoldSettings?
  scaffoldTracks           ScaffoldTrack[]
  scaffoldGateResults      ScaffoldGateResult[]
  scaffoldGateOverrides    ScaffoldGateOverride[]
  scaffoldBusinessCases    ScaffoldBusinessCase[]
  scaffoldBcVersions       ScaffoldBusinessCaseVersion[]
  scaffoldBcMetrics        ScaffoldBusinessCaseMetric[]
  scaffoldBcContests       ScaffoldBusinessCaseContest[]
  scaffoldOverlays         ScaffoldTemplateOverlay[]
  scaffoldOverlayConflicts ScaffoldOverlayConflict[]
  // Big Bang — aprovações de operação de plataforma (o tenant aqui é `system`)
  platformApprovals        PlatformApproval[]            @relation("PlatformApprovalSystemTenant")
  staffDiagrams            StaffDiagram[]                @relation("StaffDiagramSystemTenant")
  accessLogs               AccessLog[]                   @relation("AccessLogSystemTenant")
  ipAssets                 IpAsset[]                     @relation("IpAssetSystemTenant")
  staffPeople              StaffPerson[]                 @relation("StaffPersonSystemTenant")
  engagements              Engagement[]                  @relation("EngagementSystemTenant")
  proposals                Proposal[]                    @relation("ProposalSystemTenant")
  leads                    Lead[]                        @relation("LeadSystemTenant")
  services                 Service[]                     @relation("ServiceSystemTenant")
