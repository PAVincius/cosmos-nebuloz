model User {
  id               String   @id @default(cuid())
  email            String   @unique
  name             String?
  emailVerified    Boolean  @default(false)
  image            String?
  twoFactorEnabled Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  sessions                Session[]
  accounts                Account[]
  memberships             TenantMember[]
  // Lista, não opcional-único: o `userId` da TwoFactor deixou de ser `@unique`
  // porque o `enable` do better-auth sempre insere linha nova.
  twoFactor               TwoFactor[]
  // Charter — papel de governança, ortogonal ao papel SAFe de TenantMember
  charterMemberships      CharterMembership[]
  // Meridian — papel de diagnóstico, ortogonal aos dois anteriores
  meridianMemberships     MeridianMembership[]
  // Signal — papel de medição, ortogonal aos três anteriores.
  // As relações nomeadas existem porque a mesma pessoa aparece em dois papéis
  // distintos na mesma tabela (dona e encerradora da iniciativa; dona e
  // resolvedora do alerta) — sem nome, o Prisma não sabe qual FK é qual.
  signalMemberships       SignalMember[]
  // Scaffold — papel de adoção, ortogonal aos anteriores
  scaffoldMemberships     ScaffoldMembership[]
  signalOwnedInitiatives  SignalInitiative[]        @relation("SignalInitiativeOwner")
  signalClosedInitiatives SignalInitiative[]        @relation("SignalInitiativeCloser")
  signalSignedBaselines   SignalBaseline[]
  signalOwnedConnections  SignalConnection[]
  signalChangedMappings   SignalMetricMapping[]
  signalRecordedObs       SignalMetricObservation[]
  signalChangedFormulas   SignalRoiFormula[]
  signalOwnedAlerts       SignalAlert[]             @relation("SignalAlertOwner")
  signalResolvedAlerts    SignalAlert[]             @relation("SignalAlertResolver")
  signalGeneratedReports  SignalReportSnapshot[]
}

/// Tabela do plugin `twoFactor` do better-auth. Os campos são ditados por ele,
/// não por nós: a lib grava direto aqui pelo adapter do Prisma, e qualquer
/// coluna que ela espere e não exista vira PrismaClientValidationError — 500 no
/// cadastro, sem aviso em build nem em teste.
///
/// Foi o que aconteceu: a migration 20260518012140 nasceu contra uma versão
/// anterior do plugin e ficou três colunas atrás.
model TwoFactor {
  id          String @id @default(cuid())
  secret      String
  backupCodes String
  userId      String

  /// `true` por padrão de propósito, seguindo a lib: linhas que já existiam
  /// antes desta coluna são tratadas como verificadas. O `enable` grava `false`
  /// explicitamente, e linha não verificada não é oferecida como método de
  /// login.
  verified                Boolean   @default(true)
  /// Falhas consecutivas de segundo fator. É o orçamento do bloqueio de conta.
  failedVerificationCount Int       @default(0)
  /// Quando o bloqueio expira. Nulo = não bloqueada.
  lockedUntil             DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Índice, não `@unique`. A lib declara índice e o `enable` faz `create` puro:
  // com restrição de unicidade, um segundo cadastro — depois de abandonar o
  // primeiro, ou ao trocar de método — viola P2002 e devolve outro 500.
  @@index([userId])
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  activeTenantId String?
  activeTenant   Tenant? @relation("SessionActiveTenant", fields: [activeTenantId], references: [id], onDelete: SetNull)

  @@unique([token])
  @@index([userId])
  @@index([activeTenantId])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model TenantMember {
  id        String     @id @default(cuid())
  tenantId  String
  userId    String
  role      MemberRole @default(MEMBER)
  createdAt DateTime   @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([tenantId])
  @@index([userId])
}

model TenantInvitation {
  id        String           @id @default(cuid())
  tenantId  String
  email     String
  role      MemberRole       @default(MEMBER)
  status    InvitationStatus @default(PENDING)
  expiresAt DateTime
  inviterId String
  createdAt DateTime         @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}
