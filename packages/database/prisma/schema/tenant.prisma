  // Charter — governança de IA
  charterMemberships        CharterMembership[]
  charterSettings           CharterSettings?
  charterPolicies           CharterPolicy[]
  charterPolicySections     CharterPolicySection[]
  charterPolicyVersions     CharterPolicyVersion[]
  charterUseCases           CharterUseCase[]
  charterDecisions          CharterDecision[]
  charterMitigations        CharterMitigation[]
  charterVendors            CharterVendor[]
  charterClauses            CharterClause[]
  charterVendorClauses      CharterVendorClause[]
  charterTracks             CharterTrack[]
  charterAcknowledgments    CharterAcknowledgment[]
  charterSequences          CharterSequence[]
  charterPolicyLinks        CharterPolicyLink[]
  charterRequirementSets    CharterRequirementSet[]
  charterCoverages          CharterCoverage[]
  // Meridian — diagnóstico de prontidão para IA. As duas tabelas de benchmark
