enum SubscriptionPlan {
  ORBIT
  GALAXY
  NEBULA
  UNIVERSE
}

enum MemberRole {
  ADMIN
  STE
  RTE
  SM
  PO
  DEV
  MEMBER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELED
}

