// Wave 4 — Portfolio Governance (LPM)

model GovernedEpic {
  id                       String    @id @default(cuid())
  tenantId                 String
  epicId                   String    @unique
  valueStreamId            String? // artId of the ART/value stream
  themeId                  String? // strategicThemeId
  investmentEstimate       Float?
  governanceStatus         String    @default("draft") // draft/review/approved/rejected/on_hold/deferred
  guardrailFlags           Json      @default("[]") // string[]
  currentApprovalRequestId String?
  // Multi-step workflow fields (story-016)
  currentStepIndex         Int       @default(0)
  submittedBy              String?
  submittedAt              DateTime?
  bypassedAt               DateTime?
  bypassedBy               String?
  slaBreachAt              DateTime?
  allowApprovalBypass      Boolean   @default(false)
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  epic             Epic              @relation(fields: [epicId], references: [id], onDelete: Cascade)
  approvalRequests ApprovalRequest[]

  @@index([tenantId])
  @@index([tenantId, governanceStatus])
}

model ApprovalWorkflow {
  id        String   @id @default(cuid())
  tenantId  String
  tipo      String // epic_investment / budget_guardrail_change / theme_creation
  nome      String
  etapas    Json // [{order: number, roleRequired: string, criteria?: string}]
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  requests ApprovalRequest[]

  @@unique([tenantId, tipo])
  @@index([tenantId])
}

model ApprovalRequest {
  id             String    @id @default(cuid())
  tenantId       String
  workflowId     String
  targetType     String // epic / guardrail / theme
  targetId       String
  estado         String    @default("open") // open / in_review / approved / rejected / cancelled
  initiatorId    String
  governedEpicId String?
  // Multi-step fields (story-016)
  stepIndex      Int       @default(0)
  assignedTo     String?
  decision       String?
  reason         String?   @db.Text
  decidedAt      DateTime?
  slaBreachedAt  DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenant       Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workflow     ApprovalWorkflow       @relation(fields: [workflowId], references: [id])
  governedEpic GovernedEpic?          @relation(fields: [governedEpicId], references: [id], onDelete: SetNull)
  steps        ApprovalStepInstance[]

  @@index([tenantId])
  @@index([tenantId, estado])
  @@index([governedEpicId])
}

model ApprovalStepInstance {
  id                String    @id @default(cuid())
  tenantId          String
  approvalRequestId String
  etapaOrdem        Int
  roleRequired      String // lpm / enterprise_architect / cfo / finance
  approverId        String?
  backupApproverId  String?
  estado            String    @default("pending") // pending / approved / rejected / skipped
  comentario        String?   @db.Text
  timestamp         DateTime?
  // Story-040 SLA tracking
  slaDeadline       DateTime?
  slaStatus         String    @default("ON_TRACK") // ON_TRACK / BREACHED
  isParallel        Boolean   @default(false)
  createdAt         DateTime  @default(now())

  tenant                Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  approvalRequest       ApprovalRequest        @relation(fields: [approvalRequestId], references: [id], onDelete: Cascade)
  governanceEscalations GovernanceEscalation[]

  @@index([tenantId])
  @@index([approvalRequestId])
  @@index([slaDeadline])
}

model GovernanceEscalation {
  id               String    @id @default(cuid())
  tenantId         String
  approvalStepId   String
  epicId           String?
  escalatedAt      DateTime  @default(now())
  backupNotified   Boolean   @default(false)
  backupNotifiedAt DateTime?

  tenant       Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  approvalStep ApprovalStepInstance @relation(fields: [approvalStepId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([approvalStepId])
}

model DecisionLogEntry {
  id            String   @id @default(cuid())
  tenantId      String
  tipo          String // epic_decision / budget_decision / theme_decision
  targetType    String // epic / guardrail / theme
  targetId      String
  valueStreamId String?
  decisao       String // approved / rejected / deferred / changed
  justificativa String   @db.Text
  dadosSuporte  Json     @default("{}") // { flowMetrics?, okrs?, budgetInfo? }
  decisorId     String
  dataDecisao   DateTime @default(now())
  // cosmos.html screen-governance DecisionsScreen
  titulo        String?
  tags          String[] @default([])
  createdAt     DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, tipo])
  @@index([tenantId, dataDecisao])
}

/// Aprovação de operação **de plataforma** — não confundir com ApprovalRequest.
///
/// ApprovalRequest, acima, é governança do cliente sobre o domínio dele: épico,
/// guardrail, tema, com workflow configurável, múltiplas etapas, SLA e papéis
/// (lpm, cfo). O `tenantId` dele é o tenant DONO do objeto governado.
///
/// Aqui a relação se inverte. O solicitante e o aprovador são staff da Nebuloz,
/// o alvo é um tenant (ou uma proposta), e não há etapa: é um pedido, uma
/// decisão. Reusar ApprovalRequest exigiria criar workflow no tenant `system`
/// para cada tipo de ação, traduzir vocabulário de estado e carregar máquina de
/// etapas que nunca roda — shoehorn, não reuso.
///
/// Existe porque cinco operações do Big Bang não executam no clique, por
/// decisão de produto (PRD §6.3): deleção de tenant, MCP writes avançadas,
/// desconto comercial acima de 15%, export sensível e mudança grande de plano.
model PlatformApproval {
  id String @id @default(cuid())

  /// Sempre o tenant interno (`system`) — é lá que o staff vive. O tenant
  /// AFETADO pela operação é `targetTenantId`, que é outra coisa.
  tenantId String

  /// Que operação foi pedida. Fechado no app, não no banco, porque a lista
  /// cresce a cada onda e enum em Postgres pede migration para cada valor novo.
  acao      String
  /// tenant | module | policy | export | proposal
  alvoTipo  String
  alvoId    String
  /// Denormalizado para a fila não precisar de join só para escrever a linha.
  alvoLabel String

  /// FR-8.2 — o aprovador não decide sem contexto: motivo do pedido e impacto
  /// estimado são obrigatórios na criação, não opcionais preenchidos depois.
  motivo  String @db.Text
  impacto String @db.Text

  /// Payload da ação original, para executá-la na aprovação (FR-8.4).
  payload Json @default("{}")

  status String @default("PENDING_APPROVAL") // PENDING_APPROVAL | APPROVED | REJECTED

  solicitanteId   String
  solicitanteNome String?
  criadoEm        DateTime @default(now())

  /// Trilha de decisão: quem e quando. Nulos enquanto pendente.
  decisorId   String?
  decisorNome String?
  decididoEm  DateTime?
  /// Nota da decisão — a rejeição costuma precisar dela mais que a aprovação.
  nota        String?   @db.Text

  /// Tenant afetado pela operação. SetNull para a trilha sobreviver à remoção
  /// do alvo: aprovação é registro histórico, não some junto com o objeto.
  targetTenantId String?

  tenant Tenant @relation("PlatformApprovalSystemTenant", fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([targetTenantId])
  @@index([criadoEm])
}

/// Diagrama do back-office: BPMN ou diagrama-como-código.
///
/// Uma entidade para os dois porque são a mesma coisa — texto versionado que
/// renderiza como diagrama. Separar em `BpmnProcess` e `MermaidDiagram` daria
/// duas tabelas com os mesmos campos, duas actions com as mesmas guardas e
/// duas telas de histórico; a única diferença real é qual renderizador monta o
/// canvas, e isso é uma coluna.
///
/// `source` é a fonte da verdade: XML BPMN 2.0 ou DSL Mermaid. O canvas reflete
/// o texto, nunca o contrário — é o que torna o diagrama versionável em git e
/// diffável numa revisão.
model StaffDiagram {
  id   String @id @default(cuid())
  /// Tenant dono da linha. É sempre o tenant `system`: diagrama é artefato da
  /// Nebuloz, não do cliente. O campo existe para a mesma trilha de auditoria
  /// e o mesmo escopo que o resto do painel usa.
  tenantId String

  kind String // BPMN | MERMAID
  name String
  slug String
  /// Para que serve este diagrama — some da tela sem isso e vira arquivo órfão.
  descricao String? @db.Text

  /// Conteúdo atual. O histórico completo fica em StaffDiagramVersion.
  source String @db.Text

  /// Cliente que o diagrama descreve, quando descreve algum. SetNull porque o
  /// diagrama sobrevive à saída do cliente — é conhecimento da casa.
  sobreTenantId String?

  criadoPorId   String
  criadoPorNome String?
  criadoEm      DateTime @default(now())
  atualizadoEm  DateTime @updatedAt

  tenant   Tenant                @relation("StaffDiagramSystemTenant", fields: [tenantId], references: [id], onDelete: Cascade)
  versions StaffDiagramVersion[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([tenantId, kind])
  @@index([sobreTenantId])
}

/// Uma revisão do diagrama. Append-only: editar cria linha nova, nunca altera
/// a anterior. Sem isso "versionado" seria só a data da última gravação, e a
/// pergunta que o operador realmente faz — o que mudou entre a v3 e a v4 — não
/// teria como ser respondida.
model StaffDiagramVersion {
  id         String @id @default(cuid())
  diagramId  String
  /// Sequencial por diagrama, começando em 1. É o número que a tela mostra.
  versao     Int
  source     String @db.Text
  /// Por que mudou. Curto e obrigatório na UI: diff sem motivo obriga a ler o
  /// diff inteiro para descobrir a intenção.
  nota       String? @db.Text
  autorId    String
  autorNome  String?
  criadoEm   DateTime @default(now())

  diagram StaffDiagram @relation(fields: [diagramId], references: [id], onDelete: Cascade)

  @@unique([diagramId, versao])
  @@index([diagramId])
}
