// Contratação modular da plataforma Nebuloz.
//
// Um tenant contrata Cosmos, Charter, Signal, Meridian ou qualquer combinação. Isto não é
// feature flag: `contractedAt`/`expiresAt` são rastro comercial, não toggle de
// rollout. Ausência de linha = módulo não contratado (default deny) — a
// migration inicial semeia COSMOS para os tenants existentes.

/// `ProductModule` governa ACESSO; `PrecoDeModulo` (comercial.prisma) governa
/// PREÇO RECORRENTE. Entrar num sem entrar no outro é coerente e deliberado:
/// o Scaffold é vendido por projeto, não por assinatura, então ele existe aqui
/// — senão não haveria como negar acesso a quem não comprou — e fica fora do
/// preço de módulo. Ver `docs/produto/scaffold-prd.md` §6 e
/// `specs/002-scaffold-adoption/research.md` §R2 antes de "consertar" a
/// ausência do outro lado.
enum ProductModule {
  COSMOS
  CHARTER
  SIGNAL
  MERIDIAN
  SCAFFOLD
}

enum ModuleStatus {
  ACTIVE
  TRIAL
  SUSPENDED
  CANCELED
}

model TenantModule {
  id           String        @id @default(cuid())
  tenantId     String
  module       ProductModule
  status       ModuleStatus  @default(ACTIVE)
  contractedAt DateTime      @default(now())
  expiresAt    DateTime?
  seats        Int?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  updatedBy    String?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, module])
  @@index([tenantId])
  @@index([tenantId, status])
}
