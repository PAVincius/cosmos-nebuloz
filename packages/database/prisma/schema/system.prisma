// ── AI Copilot ───────────────────────────────────────────────────────────────

model CopilotSession {
  id            String    @id @default(cuid())
  tenantId      String
  userId        String?
  mode          String    @default("global") // global | rte | lpm | pm | team | spc
  surface       String? // page/view where session was started
  title         String?   @db.Text // first user message, cached for sidebar display
  messages      Json? // [{role, content, ts}] — full conversation cache for quick load
  messageCount  Int       @default(0)
  lastMessageAt DateTime?
  pinnedAt      DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  chatMessages CopilotMessage[]

  @@index([tenantId])
  @@index([tenantId, userId])
  @@index([tenantId, updatedAt(sort: Desc)])
  @@map("copilot_sessions")
}

model CopilotMessage {
  id        String   @id @default(cuid())
  tenantId  String
  sessionId String
  role      String // user | assistant
  content   String   @db.Text
  tokens    Int?
  createdAt DateTime @default(now())

  tenant  Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  session CopilotSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([tenantId, sessionId])
  @@map("copilot_messages")
}

// ── System horizontal features ────────────────────────────────────────────────

model Notification {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  type      String // mention/assignment/risk/deadline/system/broadcast
  title     String
  body      String?
  read      Boolean  @default(false)
  pinned    Boolean  @default(false)
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
  @@index([userId, read])
  @@index([tenantId])
}

model NotificationPreference {
  id          String  @id @default(cuid())
  tenantId    String
  userId      String
  type        String // anomaly | mention | deadline | system
  digestMode  Boolean @default(false)
  digestCron  String? // cron expression e.g. "0 8 * * *" for daily 08:00
  channelIn   Boolean @default(true) // in-app
  channelMail Boolean @default(false)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId, type])
  @@index([tenantId, userId])
}

model AuditLog {
  id           String   @id @default(cuid())
  tenantId     String
  userId       String?
  actorId      String?
  actorType    String? // user | system
  action       String
  entityType   String?
  entityId     String?
  diff         Json?
  metadata     Json?
  ipAddress    String?
  userAgent    String?
  targetUserId String?
  reason       String?
  createdAt    DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([tenantId, entityType, entityId])
  @@index([tenantId, createdAt])
}

// ── LGPD Data Subject Requests ────────────────────────────────────────────────

enum DsrType {
  ERASURE
  PORTABILITY
}

enum DsrStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
}

model DataSubjectRequest {
  id          String    @id @default(cuid())
  tenantId    String
  subjectId   String
  type        DsrType
  status      DsrStatus @default(PENDING)
  requestedAt DateTime  @default(now())
  processedAt DateTime?
  metadata    Json?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, subjectId])
  @@index([tenantId, status])
}

model Integration {
  id         String    @id @default(cuid())
  tenantId   String
  source     String // linear | github | asana | gitlab | jira | azure-devops | billing_aws | billing_gcp | billing_azure
  name       String
  config     Json // { apiKey, org, token, ... } — sensitive, store encrypted at app layer
  mapping    Json? // { statusMap, typeMap, teamId, artId, piId }
  status     String    @default("ACTIVE") // ACTIVE | INACTIVE | ERROR
  lastSyncAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  syncLogs          SyncLog[]
  // FinOps back-refs
  billingEntries    BillingEntry[]
  billingSyncCursor BillingSyncCursor?

  @@index([tenantId])
  @@index([tenantId, source])
}

model SyncLog {
  id            String   @id @default(cuid())
  integrationId String
  type          String // snapshot | webhook | push
  status        String // success | partial | error
  itemsCreated  Int      @default(0)
  itemsUpdated  Int      @default(0)
  itemsSkipped  Int      @default(0)
  errors        Json?
  createdAt     DateTime @default(now())

  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@index([integrationId])
  @@index([integrationId, createdAt])
}
