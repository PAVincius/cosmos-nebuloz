<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definicoes_PZ23" targetNamespace="https://nebuloz.ai/processos" exporter="@repo/bpmn" exporterVersion="1">
  <bpmn:collaboration id="Colaboracao_PZ23">
    <bpmn:participant id="Pool_PZ23" name="Nebuloz — resposta a incidente de segurança" processRef="Processo_PZ23" />
  </bpmn:collaboration>
  <bpmn:process id="Processo_PZ23" name="Resposta a incidente" isExecutable="false">
    <bpmn:documentation>PZ-23 · Resposta a incidente. Gerado de definição JSON por @repo/bpmn — não edite o XML à mão.
Fonte: docs/compliance/soc2/policies/02-incident-response-plan.md — §2 Severity; §3 Team; §4 Response Phases 1–6; §5 Evidence; §6 Customer Notification; §7 Regulatory Reporting
Lacuna: Quem detecta e faz o registro inicial (hora, fonte, canal, acionar o Incident Commander) não está nomeado; a raia diz isso.
Lacuna: O plano não dá ordem entre notificação (§6, §7) e erradicação/recuperação (fases 4–5); o prazo de 72 h conta da descoberta, então o desenho põe a notificação logo após a contenção. Na prática correm em paralelo — o esquema só tem gateway exclusivo.
Lacuna: P2/P3 manda 'monitorar escalada' sem gatilho de reclassificação; não há volta desenhada.
Lacuna: Papéis por cargo (CTO, Engineering Lead, CEO, jurídico externo), sem nomes; o RACI do playbook §4 está em branco.
Lacuna: O canal '#incident-AAAA-MM-DD-descricao' não diz em que ferramenta; o contato é security@nebuloz.ai, e a produção é nebuloz.ai — confirmar o domínio.
Lacuna: BetterStack aparece como fonte de alerta, mas não consta do inventário de dpa-fornecedores.md (que tem Sentry).
Lacuna: Os runbooks do §8 (conta comprometida, exfiltração, CVE) não estão desenhados; conta comprometida de staff segue PZ-22.
Lacuna: O plano está em inglês, escrito para 'Cosmos', versão 1.0 de 2026-05-19.</bpmn:documentation>
    <bpmn:laneSet id="Raias_PZ23">
      <bpmn:lane id="Raia_deteccao" name="Quem detecta (não nomeado)">
        <bpmn:flowNodeRef>Inicio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Registrar</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Raia_ic" name="Incident Commander (CTO)">
        <bpmn:flowNodeRef>Triar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Notificar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Severidade</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>JuntaContencao</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NotificaCliente</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>JuntaAviso</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>DadoPessoal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>JuntaRegulador</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PostMortem</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Atualizar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Encerrado</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Raia_tecnico" name="Líder técnico (Engineering Lead)">
        <bpmn:flowNodeRef>Isolar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Preservar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Restringir</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Erradicar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Recuperar</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Raia_comunicacao" name="Comunicação (CEO) e jurídico">
        <bpmn:flowNodeRef>InformarCeo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AvisarClientes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>StatusPage</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Anpd</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Inicio" name="Alerta, relato de usuário ou de terceiro">
      <bpmn:documentation>Origem: §4 Fase 1 Triggers</bpmn:documentation>
      <bpmn:outgoing>Fluxo_Inicio_Registrar</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Registrar" name="Registrar hora e fonte, abrir canal, acionar o Incident Commander">
      <bpmn:documentation>Origem: §4 Fase 1 Actions</bpmn:documentation>
      <bpmn:incoming>Fluxo_Inicio_Registrar</bpmn:incoming>
      <bpmn:outgoing>Fluxo_Registrar_Triar</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Triar" name="Triar em até 30 min: severidade P0–P3 e escopo">
      <bpmn:documentation>Origem: §4 Fase 2; §2</bpmn:documentation>
      <bpmn:incoming>Fluxo_Registrar_Triar</bpmn:incoming>
      <bpmn:outgoing>Fluxo_Triar_Notificar</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Notificar" name="Notificar o time e abrir a linha do tempo">
      <bpmn:documentation>Origem: §4 Fase 2</bpmn:documentation>
      <bpmn:incoming>Fluxo_Triar_Notificar</bpmn:incoming>
      <bpmn:outgoing>Fluxo_Notificar_Severidade</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Severidade" name="Severidade?">
      <bpmn:documentation>Origem: §2</bpmn:documentation>
      <bpmn:incoming>Fluxo_Notificar_Severidade</bpmn:incoming>
      <bpmn:outgoing>Fluxo_Severidade_Isolar</bpmn:outgoing>
      <bpmn:outgoing>Fluxo_Severidade_Restringir</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Isolar" name="Isolar sistemas: chaves, sessões, IPs">
      <bpmn:documentation>Origem: §4 Fase 3 P0/P1</bpmn:documentation>
      <bpmn:incoming>Fluxo_Severidade_Isolar</bpmn:incoming>
      <bpmn:outgoing>Fluxo_Isolar_Preservar</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Preservar" name="Preservar evidência e ampliar logs">
      <bpmn:documentation>Origem: §4 Fase 3; §5</bpmn:documentation>
      <bpmn:incoming>Fluxo_Isolar_Preservar</bpmn:incoming>
      <bpmn:outgoing>Fluxo_Preservar_InformarCeo</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="InformarCeo" name="Informar o CEO">
      <bpmn:documentation>Origem: §4 Fase 3 P0/P1</bpmn:documentation>
      <bpmn:incoming>Fluxo_Preservar_InformarCeo</bpmn:incoming>
      <bpmn:outgoing>Fluxo_InformarCeo_JuntaContencao</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Restringir" name="Restringir o componente e monitorar escalada">
      <bpmn:documentation>Origem: §4 Fase 3 P2/P3</bpmn:documentation>
      <bpmn:incoming>Fluxo_Severidade_Restringir</bpmn:incoming>
      <bpmn:outgoing>Fluxo_Restringir_JuntaContencao</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="JuntaContencao">
      <bpmn:incoming>Fluxo_InformarCeo_JuntaContencao</bpmn:incoming>
      <bpmn:incoming>Fluxo_Restringir_JuntaContencao</bpmn:incoming>
      <bpmn:outgoing>Fluxo_JuntaContencao_NotificaCliente</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="NotificaCliente" name="Cliente precisa ser notificado?">
      <bpmn:documentation>Origem: §6</bpmn:documentation>
      <bpmn:incoming>Fluxo_JuntaContencao_NotificaCliente</bpmn:incoming>
      <bpmn:outgoing>Fluxo_NotificaCliente_AvisarClientes</bpmn:outgoing>
      <bpmn:outgoing>Fluxo_NotificaCliente_StatusPage</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="AvisarClientes" name="Notificar clientes (P0: 72 h, com revisão jurídica)">
      <bpmn:documentation>Origem: §6</bpmn:documentation>
      <bpmn:incoming>Fluxo_NotificaCliente_AvisarClientes</bpmn:incoming>
      <bpmn:outgoing>Fluxo_AvisarClientes_JuntaAviso</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="StatusPage" name="Atualizar a status page">
      <bpmn:documentation>Origem: §6 P2/P3</bpmn:documentation>
      <bpmn:incoming>Fluxo_NotificaCliente_StatusPage</bpmn:incoming>
      <bpmn:outgoing>Fluxo_StatusPage_JuntaAviso</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="JuntaAviso">
      <bpmn:incoming>Fluxo_AvisarClientes_JuntaAviso</bpmn:incoming>
      <bpmn:incoming>Fluxo_StatusPage_JuntaAviso</bpmn:incoming>
      <bpmn:outgoing>Fluxo_JuntaAviso_DadoPessoal</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="DadoPessoal" name="Violação confirmada de dado pessoal?">
      <bpmn:documentation>Origem: §7</bpmn:documentation>
      <bpmn:incoming>Fluxo_JuntaAviso_DadoPessoal</bpmn:incoming>
      <bpmn:outgoing>Fluxo_DadoPessoal_Anpd</bpmn:outgoing>
      <bpmn:outgoing>Fluxo_DadoPessoal_JuntaRegulador</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Anpd" name="Reportar à ANPD em 72 h (e GDPR se couber)">
      <bpmn:documentation>Origem: §7</bpmn:documentation>
      <bpmn:incoming>Fluxo_DadoPessoal_Anpd</bpmn:incoming>
      <bpmn:outgoing>Fluxo_Anpd_JuntaRegulador</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="JuntaRegulador">
      <bpmn:incoming>Fluxo_DadoPessoal_JuntaRegulador</bpmn:incoming>
      <bpmn:incoming>Fluxo_Anpd_JuntaRegulador</bpmn:incoming>
      <bpmn:outgoing>Fluxo_JuntaRegulador_Erradicar</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Erradicar" name="Erradicar: causa raiz, correção, rotação de credenciais">
      <bpmn:documentation>Origem: §4 Fase 4</bpmn:documentation>
      <bpmn:incoming>Fluxo_JuntaRegulador_Erradicar</bpmn:incoming>
      <bpmn:outgoing>Fluxo_Erradicar_Recuperar</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Recuperar" name="Recuperar: restaurar, verificar controles, monitorar 24 h">
      <bpmn:documentation>Origem: §4 Fase 5</bpmn:documentation>
      <bpmn:incoming>Fluxo_Erradicar_Recuperar</bpmn:incoming>
      <bpmn:outgoing>Fluxo_Recuperar_PostMortem</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="PostMortem" name="Post-mortem sem culpa em até 5 dias úteis">
      <bpmn:documentation>Origem: §4 Fase 6</bpmn:documentation>
      <bpmn:incoming>Fluxo_Recuperar_PostMortem</bpmn:incoming>
      <bpmn:outgoing>Fluxo_PostMortem_Atualizar</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Atualizar" name="Atualizar runbooks e controles; compartilhar o resumo">
      <bpmn:documentation>Origem: §4 Fase 6</bpmn:documentation>
      <bpmn:incoming>Fluxo_PostMortem_Atualizar</bpmn:incoming>
      <bpmn:outgoing>Fluxo_Atualizar_Encerrado</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="Encerrado" name="Incidente encerrado">
      <bpmn:incoming>Fluxo_Atualizar_Encerrado</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Fluxo_Inicio_Registrar" sourceRef="Inicio" targetRef="Registrar" />
    <bpmn:sequenceFlow id="Fluxo_Registrar_Triar" sourceRef="Registrar" targetRef="Triar" />
    <bpmn:sequenceFlow id="Fluxo_Triar_Notificar" sourceRef="Triar" targetRef="Notificar" />
    <bpmn:sequenceFlow id="Fluxo_Notificar_Severidade" sourceRef="Notificar" targetRef="Severidade" />
    <bpmn:sequenceFlow id="Fluxo_Severidade_Isolar" name="P0 ou P1" sourceRef="Severidade" targetRef="Isolar">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">P0 ou P1</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Fluxo_Severidade_Restringir" name="P2 ou P3" sourceRef="Severidade" targetRef="Restringir">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">P2 ou P3</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Fluxo_Isolar_Preservar" sourceRef="Isolar" targetRef="Preservar" />
    <bpmn:sequenceFlow id="Fluxo_Preservar_InformarCeo" sourceRef="Preservar" targetRef="InformarCeo" />
    <bpmn:sequenceFlow id="Fluxo_InformarCeo_JuntaContencao" sourceRef="InformarCeo" targetRef="JuntaContencao" />
    <bpmn:sequenceFlow id="Fluxo_Restringir_JuntaContencao" sourceRef="Restringir" targetRef="JuntaContencao" />
    <bpmn:sequenceFlow id="Fluxo_JuntaContencao_NotificaCliente" sourceRef="JuntaContencao" targetRef="NotificaCliente" />
    <bpmn:sequenceFlow id="Fluxo_NotificaCliente_AvisarClientes" name="sim: dado exposto ou impacto" sourceRef="NotificaCliente" targetRef="AvisarClientes">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">sim: dado exposto ou impacto</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Fluxo_NotificaCliente_StatusPage" name="não" sourceRef="NotificaCliente" targetRef="StatusPage">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">não</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Fluxo_AvisarClientes_JuntaAviso" sourceRef="AvisarClientes" targetRef="JuntaAviso" />
    <bpmn:sequenceFlow id="Fluxo_StatusPage_JuntaAviso" sourceRef="StatusPage" targetRef="JuntaAviso" />
    <bpmn:sequenceFlow id="Fluxo_JuntaAviso_DadoPessoal" sourceRef="JuntaAviso" targetRef="DadoPessoal" />
    <bpmn:sequenceFlow id="Fluxo_DadoPessoal_Anpd" name="sim" sourceRef="DadoPessoal" targetRef="Anpd">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">sim</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Fluxo_DadoPessoal_JuntaRegulador" name="não" sourceRef="DadoPessoal" targetRef="JuntaRegulador">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">não</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Fluxo_Anpd_JuntaRegulador" sourceRef="Anpd" targetRef="JuntaRegulador" />
    <bpmn:sequenceFlow id="Fluxo_JuntaRegulador_Erradicar" sourceRef="JuntaRegulador" targetRef="Erradicar" />
    <bpmn:sequenceFlow id="Fluxo_Erradicar_Recuperar" sourceRef="Erradicar" targetRef="Recuperar" />
    <bpmn:sequenceFlow id="Fluxo_Recuperar_PostMortem" sourceRef="Recuperar" targetRef="PostMortem" />
    <bpmn:sequenceFlow id="Fluxo_PostMortem_Atualizar" sourceRef="PostMortem" targetRef="Atualizar" />
    <bpmn:sequenceFlow id="Fluxo_Atualizar_Encerrado" sourceRef="Atualizar" targetRef="Encerrado" />
  </bpmn:process>
