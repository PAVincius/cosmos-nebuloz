<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definicoes_PZ22" targetNamespace="https://nebuloz.ai/processos" exporter="@repo/bpmn" exporterVersion="1">
  <bpmn:collaboration id="Colaboracao_PZ22">
    <bpmn:participant id="Pool_PZ22" name="Nebuloz — acesso da equipe ao back-office" processRef="Processo_PZ22" />
  </bpmn:collaboration>
  <bpmn:process id="Processo_PZ22" name="Acesso ao back-office" isExecutable="false">
    <bpmn:documentation>PZ-22 · Acesso ao back-office. Gerado de definição JSON por @repo/bpmn — não edite o XML à mão.
Fonte: docs/runbooks/acesso-ao-backoffice.md — O modelo; Conceder (passos 1–3); Revogar; Dívidas conhecidas
Fonte: apps/backoffice/lib/guard.ts — requirePlatformStaff — 2FA obrigatório
Lacuna: Não há tela: conceder e revogar é SQL em editor, e a concessão não é auditada (runbook, Dívidas conhecidas). PRODUCT.md registra isso como decisão em aberto.
Lacuna: O runbook não diz quem autoriza uma concessão nem o critério entre ADMIN e MEMBER — só que quem opera precisa de credencial de banco.
Lacuna: Quando o script para porque a conta não existe, o runbook não diz o próximo passo.
Lacuna: Nada cobra o passo 3 (autenticador): a listagem final do script mostra twoFactorEnabled=false, e o portão barra, sem prazo nem lembrete.
Lacuna: Revogar não derruba a sessão aberta: o acesso cai no minuto seguinte (cache de 60 s), exceto se as linhas de Session forem apagadas.
Lacuna: grant-admin-vinicius-dev.sql tem senha em texto puro num comentário versionado (runbook, Dívidas) — fora do fluxo, mas é risco do mesmo processo.</bpmn:documentation>
    <bpmn:laneSet id="Raias_PZ22">
      <bpmn:lane id="Raia_pessoa" name="Pessoa da equipe">
        <bpmn:flowNodeRef>CriarConta</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Cadastrar2fa</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Concedido</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Raia_concede" name="Quem concede (credencial de banco)">
        <bpmn:flowNodeRef>Inicio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ConcederOuRevogar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RodarGrant</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ContaExiste</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ScriptParou</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RodarDelete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Comprometida</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ApagarSessoes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CaiNaHora</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CaiEm60s</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Inicio" name="Mudança de acesso à equipe">
      <bpmn:documentation>Origem: runbook, título</bpmn:documentation>
      <bpmn:outgoing>Fluxo_Inicio_ConcederOuRevogar</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="ConcederOuRevogar" name="Conceder ou revogar?">
      <bpmn:incoming>Fluxo_Inicio_ConcederOuRevogar</bpmn:incoming>
      <bpmn:outgoing>Fluxo_ConcederOuRevogar_CriarConta</bpmn:outgoing>
      <bpmn:outgoing>Fluxo_ConcederOuRevogar_RodarDelete</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="CriarConta" name="Criar a própria conta em /sign-up do app">
      <bpmn:documentation>Origem: runbook Conceder 1</bpmn:documentation>
      <bpmn:incoming>Fluxo_ConcederOuRevogar_CriarConta</bpmn:incoming>
      <bpmn:outgoing>Fluxo_CriarConta_RodarGrant</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:manualTask id="RodarGrant" name="Rodar grant-staff-admin.sql com e-mail e papel">
      <bpmn:documentation>Origem: runbook Conceder 2</bpmn:documentation>
      <bpmn:incoming>Fluxo_CriarConta_RodarGrant</bpmn:incoming>
      <bpmn:outgoing>Fluxo_RodarGrant_ContaExiste</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="ContaExiste" name="Conta existe?">
      <bpmn:documentation>Origem: runbook Conceder 2</bpmn:documentation>
      <bpmn:incoming>Fluxo_RodarGrant_ContaExiste</bpmn:incoming>
      <bpmn:outgoing>Fluxo_ContaExiste_Cadastrar2fa</bpmn:outgoing>
      <bpmn:outgoing>Fluxo_ContaExiste_ScriptParou</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="ScriptParou" name="Script para com erro">
      <bpmn:documentation>Origem: runbook Conceder 2</bpmn:documentation>
      <bpmn:incoming>Fluxo_ContaExiste_ScriptParou</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Cadastrar2fa" name="Cadastrar autenticador em /seguranca">
      <bpmn:documentation>Origem: runbook Conceder 3; guard.ts</bpmn:documentation>
      <bpmn:incoming>Fluxo_ContaExiste_Cadastrar2fa</bpmn:incoming>
      <bpmn:outgoing>Fluxo_Cadastrar2fa_Concedido</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="Concedido" name="Acesso concedido (ADMIN escreve, MEMBER lê)">
      <bpmn:documentation>Origem: runbook O modelo</bpmn:documentation>
      <bpmn:incoming>Fluxo_Cadastrar2fa_Concedido</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:manualTask id="RodarDelete" name="Rodar o DELETE do fim do script">
      <bpmn:documentation>Origem: runbook Revogar</bpmn:documentation>
      <bpmn:incoming>Fluxo_ConcederOuRevogar_RodarDelete</bpmn:incoming>
      <bpmn:outgoing>Fluxo_RodarDelete_Comprometida</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="Comprometida" name="Conta comprometida?">
      <bpmn:documentation>Origem: runbook Revogar</bpmn:documentation>
      <bpmn:incoming>Fluxo_RodarDelete_Comprometida</bpmn:incoming>
      <bpmn:outgoing>Fluxo_Comprometida_ApagarSessoes</bpmn:outgoing>
      <bpmn:outgoing>Fluxo_Comprometida_CaiEm60s</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="ApagarSessoes" name="Apagar as linhas de Session da pessoa">
      <bpmn:documentation>Origem: runbook Revogar</bpmn:documentation>
      <bpmn:incoming>Fluxo_Comprometida_ApagarSessoes</bpmn:incoming>
      <bpmn:outgoing>Fluxo_ApagarSessoes_CaiNaHora</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:endEvent id="CaiNaHora" name="Acesso cai na hora">
      <bpmn:incoming>Fluxo_ApagarSessoes_CaiNaHora</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="CaiEm60s" name="Acesso cai em até 60 s">
      <bpmn:documentation>Origem: runbook Revogar (cache de sessão)</bpmn:documentation>
      <bpmn:incoming>Fluxo_Comprometida_CaiEm60s</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Fluxo_Inicio_ConcederOuRevogar" sourceRef="Inicio" targetRef="ConcederOuRevogar" />
    <bpmn:sequenceFlow id="Fluxo_ConcederOuRevogar_CriarConta" name="conceder" sourceRef="ConcederOuRevogar" targetRef="CriarConta">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">conceder</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Fluxo_ConcederOuRevogar_RodarDelete" name="revogar" sourceRef="ConcederOuRevogar" targetRef="RodarDelete">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">revogar</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Fluxo_CriarConta_RodarGrant" sourceRef="CriarConta" targetRef="RodarGrant" />
    <bpmn:sequenceFlow id="Fluxo_RodarGrant_ContaExiste" sourceRef="RodarGrant" targetRef="ContaExiste" />
    <bpmn:sequenceFlow id="Fluxo_ContaExiste_Cadastrar2fa" name="sim" sourceRef="ContaExiste" targetRef="Cadastrar2fa">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">sim</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Fluxo_ContaExiste_ScriptParou" name="não" sourceRef="ContaExiste" targetRef="ScriptParou">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">não</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Fluxo_Cadastrar2fa_Concedido" sourceRef="Cadastrar2fa" targetRef="Concedido" />
    <bpmn:sequenceFlow id="Fluxo_RodarDelete_Comprometida" sourceRef="RodarDelete" targetRef="Comprometida" />
    <bpmn:sequenceFlow id="Fluxo_Comprometida_ApagarSessoes" name="sim" sourceRef="Comprometida" targetRef="ApagarSessoes">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">sim</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Fluxo_Comprometida_CaiEm60s" name="não" sourceRef="Comprometida" targetRef="CaiEm60s">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">não</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Fluxo_ApagarSessoes_CaiNaHora" sourceRef="ApagarSessoes" targetRef="CaiNaHora" />
  </bpmn:process>
