<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definicoes_PZ01" targetNamespace="https://nebuloz.ai/processos" exporter="@repo/bpmn" exporterVersion="1">
  <bpmn:collaboration id="Colaboracao_PZ01">
    <bpmn:participant id="Pool_PZ01" name="Nebuloz — funil comercial" processRef="Processo_PZ01" />
  </bpmn:collaboration>
  <bpmn:process id="Processo_PZ01" name="Funil de leads" isExecutable="false">
    <bpmn:documentation>PZ-01 · Funil de leads. Gerado de definição JSON por @repo/bpmn — não edite o XML à mão.
Fonte: docs/comercial/mapa-de-processo.md — §1 Identificação de ICP; §2 Qualificação; §8 Diagrama de estados
Fonte: docs/comercial/playbook-de-vendas.md — §1 O roteiro de discovery; Sinal de desqualificação
Lacuna: Não há critério escrito de quando um lead passa de DISCOVERY para EVALUATION — a passagem é julgamento de quem toca o lead (mapa §2). O gateway 'Segue para avaliação?' desenha esse julgamento, não uma regra.
Lacuna: Critérios de saída de cada estágio vivem em EstagioDoFunil, editáveis na tela; a fonte escrita não os reproduz, então o diagrama não os detalha (mapa §2).
Lacuna: proximaAcao/proximaAcaoEm marca atraso na tela mas não dispara lembrete (mapa §2) — sem evento de tempo no diagrama.
Lacuna: Mapa §1 diz que a origem do lead é texto livre e que não há captura automática do site; todo lead entra por cadastro manual. O schema já tem canal de lead (funil v2), e o mapa não foi atualizado — conferir.
Lacuna: O mapa não diz o que acontece com o prospect que não bate com o ICP além de não ser registrado.</bpmn:documentation>
    <bpmn:laneSet id="Raias_PZ01">
      <bpmn:lane id="Raia_cadastro" name="Comercial ou RevOps">
        <bpmn:flowNodeRef>Inicio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ConferirIcp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BateIcp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ForaDoIcp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CriarLead</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Raia_dono" name="Dono do lead">
        <bpmn:flowNodeRef>Discovery</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Desqualifica</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Avaliacao</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SegueProposta</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Converter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Convertido</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>JuntaPerda</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RegistrarPerda</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Perdido</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Inicio" name="Prospect identificado (evento, indicação, site)">
      <bpmn:documentation>Origem: mapa §1 Entrada</bpmn:documentation>
      <bpmn:outgoing>Fluxo_Inicio_ConferirIcp</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="ConferirIcp" name="Conferir recorte do ICP">
      <bpmn:documentation>Origem: mapa §1; icp-e-precificacao.md</bpmn:documentation>
      <bpmn:incoming>Fluxo_Inicio_ConferirIcp</bpmn:incoming>
      <bpmn:outgoing>Fluxo_ConferirIcp_BateIcp</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="BateIcp" name="Bate com o ICP?">
      <bpmn:documentation>Origem: mapa §1</bpmn:documentation>
      <bpmn:incoming>Fluxo_ConferirIcp_BateIcp</bpmn:incoming>
      <bpmn:outgoing>Fluxo_BateIcp_CriarLead</bpmn:outgoing>
      <bpmn:outgoing>Fluxo_BateIcp_ForaDoIcp</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="ForaDoIcp" name="Prospect não registrado">
      <bpmn:incoming>Fluxo_BateIcp_ForaDoIcp</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="CriarLead" name="Cadastrar lead com origem e dono (criarLead)">
      <bpmn:documentation>Origem: mapa §1 Saída; actions/leads.ts</bpmn:documentation>
      <bpmn:incoming>Fluxo_BateIcp_CriarLead</bpmn:incoming>
      <bpmn:outgoing>Fluxo_CriarLead_Discovery</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Discovery" name="Discovery com as cinco perguntas do diagnóstico">
      <bpmn:documentation>Origem: playbook §1; mapa §2</bpmn:documentation>
      <bpmn:incoming>Fluxo_CriarLead_Discovery</bpmn:incoming>
      <bpmn:outgoing>Fluxo_Discovery_Desqualifica</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Desqualifica" name="Sinal de desqualificação?">
      <bpmn:documentation>Origem: playbook §1 Sinal de desqualificação</bpmn:documentation>
      <bpmn:incoming>Fluxo_Discovery_Desqualifica</bpmn:incoming>
      <bpmn:outgoing>Fluxo_Desqualifica_Avaliacao</bpmn:outgoing>
      <bpmn:outgoing>Fluxo_Desqualifica_JuntaPerda</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Avaliacao" name="Avaliação (estágio EVALUATION)">
      <bpmn:documentation>Origem: mapa §2</bpmn:documentation>
      <bpmn:incoming>Fluxo_Desqualifica_Avaliacao</bpmn:incoming>
      <bpmn:outgoing>Fluxo_Avaliacao_SegueProposta</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="SegueProposta" name="Segue para proposta?">
      <bpmn:documentation>Origem: mapa §2 (lead continua perdível até o fechamento)</bpmn:documentation>
      <bpmn:incoming>Fluxo_Avaliacao_SegueProposta</bpmn:incoming>
      <bpmn:outgoing>Fluxo_SegueProposta_Converter</bpmn:outgoing>
      <bpmn:outgoing>Fluxo_SegueProposta_JuntaPerda</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Converter" name="Converter em proposta (converterEmProposta)">
      <bpmn:documentation>Origem: mapa §2, estágio PROPOSAL</bpmn:documentation>
      <bpmn:incoming>Fluxo_SegueProposta_Converter</bpmn:incoming>
      <bpmn:outgoing>Fluxo_Converter_Convertido</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="Convertido" name="Lead convertido — segue em PZ-02">
      <bpmn:documentation>Origem: mapa §2 Saída (propostaId)</bpmn:documentation>
      <bpmn:incoming>Fluxo_Converter_Convertido</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="JuntaPerda">
      <bpmn:incoming>Fluxo_Desqualifica_JuntaPerda</bpmn:incoming>
      <bpmn:incoming>Fluxo_SegueProposta_JuntaPerda</bpmn:incoming>
      <bpmn:outgoing>Fluxo_JuntaPerda_RegistrarPerda</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="RegistrarPerda" name="Registrar perda (perdidoEm + motivoPerda)">
      <bpmn:documentation>Origem: mapa §2 Saída</bpmn:documentation>
      <bpmn:incoming>Fluxo_JuntaPerda_RegistrarPerda</bpmn:incoming>
      <bpmn:outgoing>Fluxo_RegistrarPerda_Perdido</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="Perdido" name="Lead perdido">
      <bpmn:incoming>Fluxo_RegistrarPerda_Perdido</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Fluxo_Inicio_ConferirIcp" sourceRef="Inicio" targetRef="ConferirIcp" />
    <bpmn:sequenceFlow id="Fluxo_ConferirIcp_BateIcp" sourceRef="ConferirIcp" targetRef="BateIcp" />
    <bpmn:sequenceFlow id="Fluxo_BateIcp_CriarLead" name="sim" sourceRef="BateIcp" targetRef="CriarLead">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">sim</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Fluxo_BateIcp_ForaDoIcp" name="não" sourceRef="BateIcp" targetRef="ForaDoIcp">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">não</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Fluxo_CriarLead_Discovery" sourceRef="CriarLead" targetRef="Discovery" />
    <bpmn:sequenceFlow id="Fluxo_Discovery_Desqualifica" sourceRef="Discovery" targetRef="Desqualifica" />
    <bpmn:sequenceFlow id="Fluxo_Desqualifica_Avaliacao" name="não" sourceRef="Desqualifica" targetRef="Avaliacao">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">não</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Fluxo_Desqualifica_JuntaPerda" name="sim: &#60;50 pessoas, sem engenharia ou Big Four" sourceRef="Desqualifica" targetRef="JuntaPerda">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">sim: &lt;50 pessoas, sem engenharia ou Big Four</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Fluxo_Avaliacao_SegueProposta" sourceRef="Avaliacao" targetRef="SegueProposta" />
    <bpmn:sequenceFlow id="Fluxo_SegueProposta_Converter" name="sim" sourceRef="SegueProposta" targetRef="Converter">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">sim</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Fluxo_SegueProposta_JuntaPerda" name="não" sourceRef="SegueProposta" targetRef="JuntaPerda">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">não</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Fluxo_Converter_Convertido" sourceRef="Converter" targetRef="Convertido" />
    <bpmn:sequenceFlow id="Fluxo_JuntaPerda_RegistrarPerda" sourceRef="JuntaPerda" targetRef="RegistrarPerda" />
    <bpmn:sequenceFlow id="Fluxo_RegistrarPerda_Perdido" sourceRef="RegistrarPerda" targetRef="Perdido" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagrama_PZ01">
