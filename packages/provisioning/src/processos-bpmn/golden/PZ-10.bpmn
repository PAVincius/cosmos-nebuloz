<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definicoes_PZ10" targetNamespace="https://nebuloz.ai/processos" exporter="@repo/bpmn" exporterVersion="1">
  <bpmn:collaboration id="Colaboracao_PZ10">
    <bpmn:participant id="Pool_PZ10" name="Nebuloz — provisionamento de cliente" processRef="Processo_PZ10" />
  </bpmn:collaboration>
  <bpmn:process id="Processo_PZ10" name="Provisionamento de tenant" isExecutable="false">
    <bpmn:documentation>PZ-10 · Provisionamento de tenant. Gerado de definição JSON por @repo/bpmn — não edite o XML à mão.
Fonte: apps/backoffice/app/actions/provisioning.ts — provisionTenantAction
Fonte: packages/provisioning/src/tenant.ts — provisionTenant (transação)
Fonte: packages/provisioning/src/modules.ts — contractModule
Fonte: packages/provisioning/src/slug.ts — uniqueSlug
Fonte: apps/backoffice/lib/guard.ts — requirePlatformStaff, assertCanWrite
Fonte: apps/backoffice/app/(staff)/clientes/novo/form.tsx — formulário e barreira de confirmação
Fonte: apps/app/app/(unauthenticated)/invite/[token]/page.tsx — aceite do convite
Fonte: docs/comercial/mapa-de-processo.md — §6 Provisionamento (gatilho manual)
Lacuna: Proposta ACEITA não dispara o provisionamento: é passo manual em /clientes/novo, sem vínculo de volta à proposta além de tenantProvisionadoSlug (mapa §6).
Lacuna: O back-office não envia o convite. O dono sem conta aceita em /invite/&lt;id&gt; no app, mas como ele recebe esse link não está no código do provisionamento.
Lacuna: O convite vale 14 dias; nada no fluxo trata expiração nem reenvio.
Lacuna: O painel manda só módulo e status: assentos e expiresAt nascem nulos (provisionTenantAction), então 'renova em N dias' fica sem dado (PRODUCT.md, Lacunas).
Lacuna: Falha dentro da transação (por exemplo, slug esgotado após 10 sufixos) desfaz tudo e volta como erro; não está desenhada como caminho próprio.
Lacuna: Preparar Charter e Meridian (bootstrapCharterAction, bootstrapMeridianAction) é passo separado na tela do cliente, não encadeado ao provisionamento; ficou fora deste diagrama.
Lacuna: A descrição do PZ-10 no mapa diz 'owner convidado'; o código só convida quando o e-mail ainda não tem conta — com conta, vincula direto como ADMIN.</bpmn:documentation>
    <bpmn:laneSet id="Raias_PZ10">
      <bpmn:lane id="Raia_staff" name="Staff ADMIN">
        <bpmn:flowNodeRef>Inicio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Preencher</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Confirmar</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Raia_backoffice" name="Back-office">
        <bpmn:flowNodeRef>Guard</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Autorizado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Recusado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Slug</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CriarTenant</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BuscarDono</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>DonoTemConta</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Vincular</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Convidar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>JuntaDono</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Contratar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Auditar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ConvitePendente</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NoAr</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Raia_dono" name="Dono do cliente">
        <bpmn:flowNodeRef>Aceitar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>DonoEntra</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Inicio" name="Decisão de criar o cliente (hoje: proposta aceita, à mão)">
      <bpmn:documentation>Origem: mapa §6 Entrada</bpmn:documentation>
      <bpmn:outgoing>Fluxo_Inicio_Preencher</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Preencher" name="Preencher nome, e-mail do dono e módulos (ACTIVE ou TRIAL)">
      <bpmn:documentation>Origem: clientes/novo/form.tsx</bpmn:documentation>
      <bpmn:incoming>Fluxo_Inicio_Preencher</bpmn:incoming>
      <bpmn:outgoing>Fluxo_Preencher_Confirmar</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Confirmar" name="Confirmar na barreira que nomeia alvo e consequência">
      <bpmn:documentation>Origem: form.tsx ConfirmarAcao</bpmn:documentation>
      <bpmn:incoming>Fluxo_Preencher_Confirmar</bpmn:incoming>
      <bpmn:outgoing>Fluxo_Confirmar_Guard</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Guard" name="Guard: sessão, teto, equipe, 2FA, escrita e cota de provisionamento">
      <bpmn:documentation>Origem: provisioning.ts:145-160; guard.ts</bpmn:documentation>
      <bpmn:incoming>Fluxo_Confirmar_Guard</bpmn:incoming>
      <bpmn:outgoing>Fluxo_Guard_Autorizado</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Autorizado" name="Autorizado?">
      <bpmn:documentation>Origem: guard.ts StaffAuthError</bpmn:documentation>
      <bpmn:incoming>Fluxo_Guard_Autorizado</bpmn:incoming>
      <bpmn:outgoing>Fluxo_Autorizado_Slug</bpmn:outgoing>
      <bpmn:outgoing>Fluxo_Autorizado_Recusado</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Recusado" name="Recusado, com o motivo na tela">
      <bpmn:documentation>Origem: safe-action Result</bpmn:documentation>
      <bpmn:incoming>Fluxo_Autorizado_Recusado</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Slug" name="Gerar slug único (até 10 sufixos)">
      <bpmn:documentation>Origem: slug.ts uniqueSlug</bpmn:documentation>
      <bpmn:incoming>Fluxo_Autorizado_Slug</bpmn:incoming>
      <bpmn:outgoing>Fluxo_Slug_CriarTenant</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="CriarTenant" name="Criar tenant">
      <bpmn:documentation>Origem: tenant.ts provisionTenant</bpmn:documentation>
      <bpmn:incoming>Fluxo_Slug_CriarTenant</bpmn:incoming>
      <bpmn:outgoing>Fluxo_CriarTenant_BuscarDono</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="BuscarDono" name="Procurar conta pelo e-mail do dono">
      <bpmn:documentation>Origem: tenant.ts</bpmn:documentation>
      <bpmn:incoming>Fluxo_CriarTenant_BuscarDono</bpmn:incoming>
      <bpmn:outgoing>Fluxo_BuscarDono_DonoTemConta</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="DonoTemConta" name="Dono já tem conta?">
      <bpmn:documentation>Origem: tenant.ts</bpmn:documentation>
      <bpmn:incoming>Fluxo_BuscarDono_DonoTemConta</bpmn:incoming>
      <bpmn:outgoing>Fluxo_DonoTemConta_Vincular</bpmn:outgoing>
      <bpmn:outgoing>Fluxo_DonoTemConta_Convidar</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Vincular" name="Vincular dono como ADMIN (TenantMember)">
      <bpmn:documentation>Origem: tenant.ts</bpmn:documentation>
      <bpmn:incoming>Fluxo_DonoTemConta_Vincular</bpmn:incoming>
      <bpmn:outgoing>Fluxo_Vincular_JuntaDono</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Convidar" name="Criar convite ADMIN de 14 dias (TenantInvitation)">
      <bpmn:documentation>Origem: tenant.ts INVITE_TTL_DAYS</bpmn:documentation>
      <bpmn:incoming>Fluxo_DonoTemConta_Convidar</bpmn:incoming>
      <bpmn:outgoing>Fluxo_Convidar_JuntaDono</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="JuntaDono">
      <bpmn:incoming>Fluxo_Vincular_JuntaDono</bpmn:incoming>
      <bpmn:incoming>Fluxo_Convidar_JuntaDono</bpmn:incoming>
      <bpmn:outgoing>Fluxo_JuntaDono_Contratar</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Contratar" name="Contratar cada módulo: upsert, invalida cache, audita">
      <bpmn:documentation>Origem: modules.ts contractModule</bpmn:documentation>
      <bpmn:incoming>Fluxo_JuntaDono_Contratar</bpmn:incoming>
      <bpmn:outgoing>Fluxo_Contratar_Auditar</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Auditar" name="Auditar tenant.provisioned">
      <bpmn:documentation>Origem: tenant.ts logPlatformAudit</bpmn:documentation>
      <bpmn:incoming>Fluxo_Contratar_Auditar</bpmn:incoming>
      <bpmn:outgoing>Fluxo_Auditar_ConvitePendente</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="ConvitePendente" name="Convite pendente?">
      <bpmn:documentation>Origem: provisioning.ts ownerLinked</bpmn:documentation>
      <bpmn:incoming>Fluxo_Auditar_ConvitePendente</bpmn:incoming>
      <bpmn:outgoing>Fluxo_ConvitePendente_NoAr</bpmn:outgoing>
      <bpmn:outgoing>Fluxo_ConvitePendente_Aceitar</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="NoAr" name="Cliente no ar com dono">
      <bpmn:incoming>Fluxo_ConvitePendente_NoAr</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Aceitar" name="Criar conta e aceitar o convite em /invite/&#60;id&#62;">
      <bpmn:documentation>Origem: apps/app invite/[token]</bpmn:documentation>
      <bpmn:incoming>Fluxo_ConvitePendente_Aceitar</bpmn:incoming>
      <bpmn:outgoing>Fluxo_Aceitar_DonoEntra</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="DonoEntra" name="Dono entra no cliente">
      <bpmn:incoming>Fluxo_Aceitar_DonoEntra</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Fluxo_Inicio_Preencher" sourceRef="Inicio" targetRef="Preencher" />
    <bpmn:sequenceFlow id="Fluxo_Preencher_Confirmar" sourceRef="Preencher" targetRef="Confirmar" />
    <bpmn:sequenceFlow id="Fluxo_Confirmar_Guard" sourceRef="Confirmar" targetRef="Guard" />
    <bpmn:sequenceFlow id="Fluxo_Guard_Autorizado" sourceRef="Guard" targetRef="Autorizado" />
    <bpmn:sequenceFlow id="Fluxo_Autorizado_Slug" name="sim" sourceRef="Autorizado" targetRef="Slug">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">sim</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Fluxo_Autorizado_Recusado" name="não" sourceRef="Autorizado" targetRef="Recusado">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">não</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Fluxo_Slug_CriarTenant" sourceRef="Slug" targetRef="CriarTenant" />
    <bpmn:sequenceFlow id="Fluxo_CriarTenant_BuscarDono" sourceRef="CriarTenant" targetRef="BuscarDono" />
    <bpmn:sequenceFlow id="Fluxo_BuscarDono_DonoTemConta" sourceRef="BuscarDono" targetRef="DonoTemConta" />
    <bpmn:sequenceFlow id="Fluxo_DonoTemConta_Vincular" name="sim" sourceRef="DonoTemConta" targetRef="Vincular">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">sim</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Fluxo_DonoTemConta_Convidar" name="não" sourceRef="DonoTemConta" targetRef="Convidar">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">não</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Fluxo_Vincular_JuntaDono" sourceRef="Vincular" targetRef="JuntaDono" />
    <bpmn:sequenceFlow id="Fluxo_Convidar_JuntaDono" sourceRef="Convidar" targetRef="JuntaDono" />
    <bpmn:sequenceFlow id="Fluxo_JuntaDono_Contratar" sourceRef="JuntaDono" targetRef="Contratar" />
    <bpmn:sequenceFlow id="Fluxo_Contratar_Auditar" sourceRef="Contratar" targetRef="Auditar" />
    <bpmn:sequenceFlow id="Fluxo_Auditar_ConvitePendente" sourceRef="Auditar" targetRef="ConvitePendente" />
    <bpmn:sequenceFlow id="Fluxo_ConvitePendente_NoAr" name="não" sourceRef="ConvitePendente" targetRef="NoAr">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">não</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Fluxo_ConvitePendente_Aceitar" name="sim" sourceRef="ConvitePendente" targetRef="Aceitar">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">sim</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Fluxo_Aceitar_DonoEntra" sourceRef="Aceitar" targetRef="DonoEntra" />
  </bpmn:process>
