# Dockerfile.e2e — Cosmos Enterprise App (E2E Testing)
#
# Otimizado para testes E2E: usa pnpm dev (não build de produção)
# para ter hot reload e variáveis de ambiente flexíveis.
#
# Build da raiz do monorepo:
#   docker build -f apps/app/Dockerfile.e2e -t cosmos-e2e-app .

FROM node:22-slim AS base

# Install pnpm
RUN corepack enable && corepack prepare pnpm@10.24.0 --activate

WORKDIR /app

# ────────────────────────────────────────────
# Instalar dependências
# ────────────────────────────────────────────
FROM base AS deps

# Copiar arquivos de dependências
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY apps/app/package.json ./apps/app/
COPY apps/api/package.json ./apps/api/
COPY apps/web/package.json ./apps/web/

# Copiar todos os packages
COPY packages/ ./packages/

# Instalar dependências (frozen para reprodutibilidade)
RUN pnpm install --frozen-lockfile --ignore-scripts

# ────────────────────────────────────────────
# App runner
# ────────────────────────────────────────────
FROM base AS runner

WORKDIR /app

# Root node_modules + pnpm store
COPY --from=deps /app/node_modules ./node_modules
# App-level node_modules
COPY --from=deps /app/apps/app/node_modules ./apps/app/node_modules
# Todos os packages com seus node_modules (deps stage tem source + node_modules instalados)
COPY --from=deps /app/packages ./packages
# Source atual do monorepo (sobrescreve source dos packages, preserva node_modules já copiados acima)
COPY . .
# Restaurar packages/node_modules que COPY . . pode ter sobrescrito com versão sem node_modules
COPY --from=deps /app/packages ./packages
# Turbopack resolve @tailwindcss/postcss a partir do CWD — expor no root node_modules
RUN mkdir -p /app/node_modules/@tailwindcss && \
    ln -sf /app/packages/design-system/node_modules/@tailwindcss/postcss /app/node_modules/@tailwindcss/postcss

WORKDIR /app/apps/app

EXPOSE 3012

# Gera o Prisma client antes de rodar
RUN cd ../../packages/database && npx prisma generate || true

CMD ["sh", "-c", "cd /app/packages/database && npx prisma migrate deploy && cd /app/apps/app && pnpm dev"]
