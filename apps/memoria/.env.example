# O pnpm memoria:up gera o .env com senhas aleatórias. À mão: copie para .env e troque TODAS as senhas.
# Gere com: openssl rand -base64 24
POSTGRES_PASSWORD=
STEC_APP_DB_PASSWORD=
NEO4J_PASSWORD=
MINIO_ROOT_USER=stec
MINIO_ROOT_PASSWORD=

# Projeções opcionais (padrão: nenhuma; tudo roda no Postgres). vetor=Qdrant, grafo=Neo4j, arquivo=MinIO.
# Ex.: COMPOSE_PROFILES=vetor,grafo,arquivo
COMPOSE_PROFILES=

# hash (padrão, local, sem semântica) ou ollama (perfil ollama)
STEC_EMBEDDING_PROVIDER=hash

# Onde a imagem oficial do MinIO não baixa, troque por um espelho.
# MINIO_IMAGE=chainguard/minio:latest
